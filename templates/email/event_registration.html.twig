<!DOCTYPE html>
<html lang="pt">
    <head>
        <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Nova inscrição</title>
    </head>
    <body style="margin:0;padding:24px;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;">
            <tr>
                <td style="background:#0E3B2E;color:#ffffff;padding:20px 24px;font-size:18px;font-weight:bold;">
                    Nova inscrição — {{ event.titlePt }}
                </td>
            </tr>
            <tr>
                <td style="padding:24px;">
                    <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;">
                        <tr><td style="color:#64748b;width:120px;">Nome</td><td><strong>{{ registration.name }}</strong></td></tr>
                        <tr><td style="color:#64748b;">Instituição</td><td>{{ registration.institution }}</td></tr>
                        <tr><td style="color:#64748b;">Função</td><td>{{ registration.role }}</td></tr>
                        <tr><td style="color:#64748b;">Cidade</td><td>{{ registration.city }}</td></tr>
                        <tr><td style="color:#64748b;">E-mail</td><td><a href="mailto:{{ registration.email }}" style="color:#2E7D4F;">{{ registration.email }}</a></td></tr>
                        <tr><td style="color:#64748b;">Telefone</td><td>{{ registration.phone }}</td></tr>
                        <tr><td style="color:#64748b;">Arquivo</td><td>{{ registration.originalFileName ?: 'Nenhum' }}</td></tr>
                    </table>
                    <p style="margin:24px 0 0;">
                        <a href="{{ url('app_admin_event_registration_index', {id: event.id}) }}" style="display:inline-block;background:#2E7D4F;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:bold;">Ver todas as inscrições</a>
                    </p>
                </td>
            </tr>
        </table>
    </body>
</html>
