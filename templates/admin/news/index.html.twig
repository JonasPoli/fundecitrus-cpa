{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-newspaper admin-page-title-icon" aria-hidden="true"></i>
            Notícias
        </h1>
        <p class="page-subtitle">Gerencie o feed de notícias e comunicados do CPA Citros.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_news_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Imagem</th>
                <th>Título (PT)</th>
                <th>Título (EN)</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for news_item in news %}
                <tr>
                    <td>
                        {% if news_item.image and news_item.image.imageName %}
                            <img src="{{ asset('uploads/' ~ news_item.image.imageName) }}" alt="{{ news_item.titlePt }}" class="h-10 w-auto rounded object-cover shadow-sm">
                        {% else %}
                            <span class="text-slate-400 text-xs">—</span>
                        {% endif %}
                    </td>
                    <td class="font-semibold">{{ news_item.titlePt }}</td>
                    <td>{{ news_item.titleEn }}</td>
                    <td class="text-xs text-slate-500">{{ news_item.date|date('d/m/Y') }}</td>
                    <td>
                        <a href="{{ path('app_admin_news_edit', {'id': news_item.id}) }}" class="btn-secondary" aria-label="Editar" title="Editar">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            Editar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Nenhuma notícia cadastrada.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            {% if news is not empty %}
                $('.admin-table').DataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                    },
                    order: [[3, 'desc']],
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
                });
            {% endif %}
        });
    </script>
{% endblock %}