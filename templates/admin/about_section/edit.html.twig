{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-circle-info admin-page-title-icon" aria-hidden="true"></i>
            Quem Somos
        </h1>
        <p class="page-subtitle">Título, texto e imagem da primeira seção da página Sobre.</p>
    </div>
    <a href="{{ path('app_sobre', {_locale: 'pt'}) }}#quem-somos" target="_blank" rel="noopener" class="btn-secondary">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        Ver no site
    </a>
</div>

{{ form_start(form) }}
    <div class="admin-card space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.titlePt) }}
            {{ form_row(form.titleEn) }}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.contentPt) }}
            {{ form_row(form.contentEn) }}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.image) }}
                {% if about_section.image and about_section.image.imageName %}
                    <div class="mt-2">
                        <span class="text-xs text-slate-500 block mb-1">Imagem atual:</span>
                        <img src="{{ asset('uploads/' ~ about_section.image.imageName) }}" alt="" class="w-48 h-32 object-cover rounded shadow border border-slate-200">
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}

{{ include('admin/_quill_script.html.twig') }}
{% endblock %}
