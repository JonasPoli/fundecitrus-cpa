{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-layer-group admin-page-title-icon" aria-hidden="true"></i>
            {{ area.id ? 'Editar' : 'Adicionar' }} Grande Área
        </h1>
    </div>
    <a href="{{ path('app_admin_research_area_index') }}" class="btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Voltar
    </a>
</div>

{{ form_start(form) }}
    <div class="admin-card">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.namePt) }}
            {{ form_row(form.nameEn) }}
        </div>
    </div>
    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}

{% if area.id %}
    <form method="post" action="{{ path('app_admin_research_area_delete', {id: area.id}) }}" onsubmit="return confirm('Excluir esta grande área também exclui as linhas e módulos dela. Continuar?');" class="text-right mt-6">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ area.id) }}">
        <button type="submit" class="btn-danger">
            <i class="fa-solid fa-trash" aria-hidden="true"></i>
            Excluir
        </button>
    </form>
{% endif %}
{% endblock %}
