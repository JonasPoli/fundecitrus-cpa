{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-images admin-page-title-icon" aria-hidden="true"></i>
            Banners da Home
        </h1>
        <p class="page-subtitle">Configure e ordene os banners de destaque com suporte a slider.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_home_banner_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th></th>
                <th>Imagem</th>
                <th>Título (PT)</th>
                <th>Título (EN)</th>
                <th>Subtítulo (PT)</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody id="home-banner-sortable">
            {% for home_banner in home_banners %}
                <tr class="sortable-row" data-id="{{ home_banner.id }}">
                    <td class="admin-table-grip-td"><i class="fa-solid fa-grip-vertical admin-table-grip-icon" aria-hidden="true"></i></td>
                    <td>
                        {% if home_banner.image and home_banner.image.imageName %}
                            <img src="{{ asset('uploads/' ~ home_banner.image.imageName) }}" alt="Preview" class="h-10 w-auto rounded object-cover shadow-sm">
                        {% else %}
                            <span class="text-slate-400 text-xs">—</span>
                        {% endif %}
                    </td>
                    <td class="font-semibold">{{ home_banner.titlePt }}</td>
                    <td>{{ home_banner.titleEn }}</td>
                    <td>{{ home_banner.subtitlePt }}</td>
                    <td>
                        {% if home_banner.isActive %}
                            <span class="badge badge-success">Sim</span>
                        {% else %}
                            <span class="badge badge-neutral">Não</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_admin_home_banner_edit', {'id': home_banner.id}) }}" class="btn-secondary" aria-label="Editar" title="Editar">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            Editar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Nenhum banner cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            {% if home_banners is not empty %}
                $('.admin-table').DataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                    },
                    ordering: false,
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
                });
            {% endif %}
        });
    </script>
    {{ include('admin/_sortable_script.html.twig', {
        tbody_id: 'home-banner-sortable',
        reorder_url: path('app_admin_reorder', { entityName: 'HomeBanner' })
    }) }}
{% endblock %}