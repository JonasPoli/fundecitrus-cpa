{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-building admin-page-title-icon" aria-hidden="true"></i>
            {{ company.id ? 'Editar' : 'Adicionar' }} Empresa do Rodapé
        </h1>
    </div>
    <a href="{{ path('app_admin_footer_company_index') }}" class="btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Voltar
    </a>
</div>

{{ form_start(form) }}
    <div class="admin-card space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.category) }}
            {{ form_row(form.name) }}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.url) }}
            <div class="md:pt-7">{{ form_row(form.newTab) }}</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.logo) }}
            </div>
            <div class="md:pt-7">{{ form_row(form.active) }}</div>
        </div>
    </div>
    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}

{% if company.id %}
    <form method="post" action="{{ path('app_admin_footer_company_delete', {id: company.id}) }}" onsubmit="return confirm('Excluir esta empresa do rodapé?');" class="text-right mt-6">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
        <button type="submit" class="btn-danger">
            <i class="fa-solid fa-trash" aria-hidden="true"></i>
            Excluir
        </button>
    </form>
{% endif %}
{% endblock %}
