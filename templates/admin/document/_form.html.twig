{{ form_start(form) }}
    <div class="admin-card space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.titlePt) }}
            {{ form_row(form.titleEn) }}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.folderPt) }}
            {{ form_row(form.folderEn) }}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.fileFile) }}
                {% if document is defined and document.fileName %}
                    <div class="mt-2 p-3 bg-slate-100 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
                        <span class="text-xs text-slate-500 block mb-1">Arquivo atual:</span>
                        <a href="{{ asset('uploads/documents/' ~ document.fileName) }}" target="_blank" class="text-primary hover:underline text-sm font-semibold inline-flex items-center gap-1">
                            <i class="fa-solid fa-download"></i> {{ document.fileName }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}