{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-file-pdf admin-page-title-icon" aria-hidden="true"></i>
            Repositório de Documentos
        </h1>
        <p class="page-subtitle">Gerencie os arquivos e pastas da Área Restrita dos Pesquisadores.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_document_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Título (PT)</th>
                <th>Pasta (PT)</th>
                <th>Pasta (EN)</th>
                <th>Arquivo</th>
                <th>Data de Upload</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for document in documents %}
                <tr>
                    <td class="font-semibold">{{ document.titlePt }}</td>
                    <td><span class="badge badge-neutral"><i class="fa-regular fa-folder-open"></i> {{ document.folderPt }}</span></td>
                    <td><span class="badge badge-neutral"><i class="fa-regular fa-folder-open"></i> {{ document.folderEn }}</span></td>
                    <td>
                        {% if document.fileName %}
                            <a href="{{ asset('uploads/documents/' ~ document.fileName) }}" target="_blank" class="text-primary hover:underline text-xs inline-flex items-center gap-1 font-semibold">
                                <i class="fa-solid fa-download"></i> Baixar Arquivo
                            </a>
                        {% else %}
                            <span class="text-slate-400 text-xs">—</span>
                        {% endif %}
                    </td>
                    <td class="text-xs text-slate-500">{{ document.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <a href="{{ path('app_admin_document_edit', {'id': document.id}) }}" class="btn-secondary" aria-label="Editar" title="Editar">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            Editar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Nenhum documento cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            {% if documents is not empty %}
                $('.admin-table').DataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                    },
                    order: [[4, 'desc']],
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
                });
            {% endif %}
        });
    </script>
{% endblock %}