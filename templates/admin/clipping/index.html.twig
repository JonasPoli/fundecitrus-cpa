{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-paperclip admin-page-title-icon" aria-hidden="true"></i>
            Clipping (Na Mídia)
        </h1>
        <p class="page-subtitle">Gerencie os registros de matérias externas publicadas sobre o CPA Citros.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_clipping_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Veículo de Mídia</th>
                <th>Título (PT)</th>
                <th>Título (EN)</th>
                <th>Link da Matéria</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for clipping_item in clippings %}
                <tr>
                    <td class="font-semibold">{{ clipping_item.veiculo }}</td>
                    <td>{{ clipping_item.titlePt }}</td>
                    <td>{{ clipping_item.titleEn }}</td>
                    <td>
                        <a href="{{ clipping_item.link }}" target="_blank" class="text-primary hover:underline text-xs inline-flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir Link
                        </a>
                    </td>
                    <td>
                        <a href="{{ path('app_admin_clipping_edit', {'id': clipping_item.id}) }}" class="btn-secondary" aria-label="Editar" title="Editar">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            Editar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Nenhum clipping cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            {% if clippings is not empty %}
                $('.admin-table').DataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                    },
                    order: [[0, 'asc']],
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
                });
            {% endif %}
        });
    </script>
{% endblock %}