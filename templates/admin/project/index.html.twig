{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-flask admin-page-title-icon" aria-hidden="true"></i>
            Projetos em Andamento
        </h1>
        <p class="page-subtitle">Gerencie os projetos de pesquisa científica ativos do CPA.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_project_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Nome (PT)</th>
                <th>Nome (EN)</th>
                <th>Módulo / Pilar (PT)</th>
                <th>Pesquisador</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for project in projects %}
                <tr>
                    <td class="font-semibold">{{ project.nomePt }}</td>
                    <td>{{ project.nomeEn }}</td>
                    <td><span class="badge badge-neutral">{{ project.moduleLabel('pt') ?: '—' }}</span></td>
                    <td>{{ project.pesquisador ? project.pesquisador.nome : '—' }}</td>
                    <td>
                        <a href="{{ path('app_admin_project_edit', {'id': project.id}) }}" class="btn-secondary" aria-label="Editar" title="Editar">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            Editar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Nenhum projeto cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            {% if projects is not empty %}
                $('.admin-table').DataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                    },
                    order: [[0, 'asc']],
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
                });
            {% endif %}
        });
    </script>
{% endblock %}