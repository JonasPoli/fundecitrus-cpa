{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">
            Bem-vindo, <strong>{{ app.user.name ?? app.user.userIdentifier }}</strong> · {{ 'now'|date('d/m/Y') }}
        </p>
    </div>
</div>

{# ── Stat Cards ────────────────────────────────────────────────────────────── #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

    {# Usuários #}
    <div class="stat-card">
        <div class="stat-card-icon bg-primary/10 text-primary" aria-hidden="true">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.users_total }}</p>
            <p class="stat-card-label">Usuários ({{ stats.users_admin }} Admins)</p>
        </div>
    </div>

    {# Pesquisadores #}
    <div class="stat-card">
        <div class="stat-card-icon bg-blue-100 text-blue-700" aria-hidden="true">
            <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.researchers_total }}</p>
            <p class="stat-card-label">Pesquisadores</p>
        </div>
    </div>

    {# Projetos #}
    <div class="stat-card">
        <div class="stat-card-icon bg-purple-100 text-purple-700" aria-hidden="true">
            <i class="fa-solid fa-microscope" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.projects_total }}</p>
            <p class="stat-card-label">Projetos Científicos</p>
        </div>
    </div>

    {# Notícias #}
    <div class="stat-card">
        <div class="stat-card-icon bg-amber-100 text-amber-700" aria-hidden="true">
            <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.news_total }}</p>
            <p class="stat-card-label">Notícias Publicadas</p>
        </div>
    </div>

    {# Eventos #}
    <div class="stat-card">
        <div class="stat-card-icon bg-emerald-100 text-emerald-700" aria-hidden="true">
            <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.events_total }}</p>
            <p class="stat-card-label">Eventos Acadêmicos</p>
        </div>
    </div>

    {# Oportunidades #}
    <div class="stat-card">
        <div class="stat-card-icon bg-rose-100 text-rose-700" aria-hidden="true">
            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.jobs_total }}</p>
            <p class="stat-card-label">Vagas ({{ stats.jobs_open }} abertas)</p>
        </div>
    </div>

    {# Documentos Restritos #}
    <div class="stat-card">
        <div class="stat-card-icon bg-slate-100 text-slate-700" aria-hidden="true">
            <i class="fa-solid fa-file-shield" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.documents_total }}</p>
            <p class="stat-card-label">Documentos Científicos</p>
        </div>
    </div>

    {# Instituições Parceiras #}
    <div class="stat-card">
        <div class="stat-card-icon bg-teal-100 text-teal-700" aria-hidden="true">
            <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
        </div>
        <div>
            <p class="stat-card-value">{{ stats.partners_total }}</p>
            <p class="stat-card-label">Instituições Parceiras</p>
        </div>
    </div>

</div>

{# ── Quick Actions and Information ─────────────────────────────────────────── #}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    {# Ações Rápidas #}
    <div class="admin-card lg:col-span-3">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-bolt text-primary mr-1" aria-hidden="true"></i>
            Atalhos Rápidos
        </h2>
        <nav aria-label="Ações rápidas" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
            <a href="{{ path('app_admin_news_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Nova Notícia
            </a>
            <a href="{{ path('app_admin_event_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Novo Evento
            </a>
            <a href="{{ path('app_admin_project_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Novo Projeto
            </a>
            <a href="{{ path('app_admin_researcher_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Novo Pesquisador
            </a>
            <a href="{{ path('app_admin_job_opportunity_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Nova Vaga/Bolsa
            </a>
            <a href="{{ path('app_admin_document_new') }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm border border-slate-100 dark:border-white/10 hover:bg-slate-950/5 dark:hover:bg-white/5 transition-colors font-medium">
                <i class="fa-solid fa-plus text-primary w-4 text-center"></i>
                Novo Documento
            </a>
        </nav>
    </div>

</div>

{% endblock %}