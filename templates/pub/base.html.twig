{% set en = app.request.locale == 'en' %}
{% set tagline = en ? 'Applied Research Center for Innovation and Sustainability in Citriculture' : 'Centro de Pesquisa Aplicada em Inovação e Sustentabilidade da Citricultura' %}
{% set main_menu = [
	{route: 'app_home', pt: 'Início', en: 'Home'},
	{route: 'app_sobre', pt: 'Sobre', en: 'About', children: [
		{anchor: 'quem-somos', pt: 'Quem somos', en: 'Who we are'},
		{anchor: 'governanca', pt: 'Governança', en: 'Governance'},
		{anchor: 'equipe', pt: 'Equipe', en: 'Team'},
		{anchor: 'parceiros', pt: 'Instituições parceiras', en: 'Partner institutions'},
	]},
	{route: 'app_pesquisa', pt: 'Pesquisa', en: 'Research', children: [
		{anchor: 'linhas', pt: 'Linhas de pesquisa', en: 'Research lines'},
		{anchor: 'documentos', pt: 'Documentos de projetos', en: 'Project documents'},
	]},
	{route: 'app_comunicacao', pt: 'Comunicação', en: 'Communication'},
	{route: 'app_eventos', pt: 'Eventos', en: 'Events'},
	{route: 'app_oportunidades', pt: 'Oportunidades', en: 'Opportunities'},
	{route: 'app_fale_conosco', pt: 'Fale Conosco', en: 'Contact Us'},
] %}
{% set active_routes = {
	app_noticia_detalhe: 'app_comunicacao',
	app_evento_detalhe: 'app_eventos',
	app_oportunidade_detalhe: 'app_oportunidades',
	app_projeto_detalhe: 'app_pesquisa',
} %}
{% set current_section = active_routes[app.current_route] ?? app.current_route %}
<!DOCTYPE html>
<html lang="{{ en ? 'en' : 'pt-BR' }}" class="scroll-smooth">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="theme-color" content="#0E3B2E">
		<meta name="description" content="{% block meta_description %}CPA Citros - {{ tagline }}.{% endblock %}">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<title>{% block title %}CPA Citros | {{ tagline }}{% endblock %}</title>

		<script src="https://cdn.tailwindcss.com?plugins=typography"></script>
		<style>
			:root {
				--color-brand-900: #0E3B2E;
				--color-brand-800: #155E4A;
				--color-brand-700: #1E6F7A;
				--color-citrus: #EEA42C;
			}
			.bg-theme-gradient {
				background-image: linear-gradient(135deg, var(--color-brand-900) 0%, var(--color-brand-800) 55%, var(--color-brand-700) 100%) !important;
				background-color: var(--color-brand-900);
			}
			.bg-theme-gradient .text-slate-300,
			.bg-theme-gradient .text-slate-400,
			.bg-theme-gradient .text-slate-500,
			.bg-theme-gradient .text-slate-600,
			.bg-theme-gradient .text-slate-700 {
				color: rgba(255, 255, 255, 0.85) !important;
			}
			.footer-card-gradient {
				background-image: linear-gradient(135deg, #155E4A 0%, #0E3B2E 100%) !important;
			}
			.site-header .brand-logo { transition: height .35s ease; }
			.site-header.is-scrolled .brand-logo { height: 3rem; }
			.site-header.is-scrolled .header-row { height: 4.25rem; }
			@media (max-width: 639px) {
				.site-header.is-scrolled .brand-tagline { opacity: 0; width: 0; padding: 0; border: 0; }
			}
			.brand-tagline { transition: opacity .25s ease; }
			.rich-content iframe,
			.rich-content .ql-video {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				border: 0;
				border-radius: 1rem;
				margin: 1.5rem 0;
			}
			.rich-content img { max-width: 100%; height: auto; border-radius: 1rem; }
			.no-scrollbar { scrollbar-width: none; }
			.no-scrollbar::-webkit-scrollbar { display: none; }
		</style>
		<script>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							sans: ['Inter', 'sans-serif']
						},
						colors: {
							primary: {
								DEFAULT: '#2E7D4F',
								light: '#4E9F66',
								dark: '#1F5E3A'
							},
							secondary: {
								DEFAULT: '#EEA42C',
								dark: '#D98E17'
							},
							citrus: '#EEA42C',
							brand: {
								900: 'var(--color-brand-900)',
								800: 'var(--color-brand-800)',
								700: 'var(--color-brand-700)'
							}
						}
					}
				}
			}
		</script>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
		{% block stylesheets %}{% endblock %}
	</head>
	<body class="font-sans text-slate-800 antialiased relative min-h-screen flex flex-col bg-slate-50">
		<a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-slate-900 focus:px-4 focus:py-2 focus:rounded-lg">{{ en ? 'Skip to content' : 'Pular para o conteúdo' }}</a>

		<!-- Barra do pesquisador -->
		<div class="bg-brand-900 text-white text-xs">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 h-10 flex items-center justify-between gap-3">
				{% if app.user %}
					<div class="flex items-center gap-2 min-w-0">
						<span class="truncate">{{ en ? 'Hello' : 'Olá' }}, <strong>{{ app.user.displayName }}</strong></span>
						<span class="text-white/30">|</span>
						<a href="{{ path('app_area_restrita', {_locale: app.request.locale}) }}" class="font-semibold hover:text-citrus whitespace-nowrap">{{ en ? 'Restricted Area' : 'Área Restrita' }}</a>
						{% if is_granted('ROLE_ADMIN') %}
							<span class="text-white/30 hidden sm:inline">|</span>
							<a href="{{ path('admin_dash') }}" class="font-semibold hover:text-citrus hidden sm:inline">Admin</a>
						{% endif %}
						<span class="text-white/30">|</span>
						<a href="{{ path('app_logout') }}" class="hover:text-citrus whitespace-nowrap" aria-label="{{ en ? 'Log out' : 'Sair' }}"><i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline"> {{ en ? 'Log out' : 'Sair' }}</span></a>
					</div>
				{% else %}
					<button type="button" id="researcher-toggle" class="inline-flex items-center gap-2 font-semibold hover:text-citrus transition-colors" aria-expanded="false" aria-controls="researcher-login">
						<i class="fa-solid fa-lock text-[11px] text-citrus" aria-hidden="true"></i>
						{{ en ? 'Researcher area' : 'Área do pesquisador' }}
						<i class="fa-solid fa-chevron-down text-[9px] opacity-70 transition-transform" aria-hidden="true"></i>
					</button>
				{% endif %}
				<div class="flex items-center gap-1.5 flex-shrink-0">
					<a href="{{ path(app.current_route ?: 'app_home', (app.current_route_parameters ?: {})|merge({_locale: 'pt'})) }}" class="px-1 {{ not en ? 'font-bold text-white' : 'text-white/60 hover:text-white' }}" aria-label="Português" {{ not en ? 'aria-current="true"' }}>PT</a>
					<span class="text-white/30">|</span>
					<a href="{{ path(app.current_route ?: 'app_home', (app.current_route_parameters ?: {})|merge({_locale: 'en'})) }}" class="px-1 {{ en ? 'font-bold text-white' : 'text-white/60 hover:text-white' }}" aria-label="English" {{ en ? 'aria-current="true"' }}>EN</a>
				</div>
			</div>
			{% if not app.user %}
				<div id="researcher-login" class="hidden border-t border-white/10">
					<form method="post" action="{{ path('app_login') }}" class="max-w-7xl mx-auto px-4 sm:px-6 py-3 grid grid-cols-1 sm:flex sm:items-center sm:justify-end gap-2">
						<span class="text-white/70 sm:mr-2">{{ en ? 'Restricted access for CPA Citros researchers' : 'Acesso restrito para pesquisadores do CPA Citros' }}</span>
						<input type="email" name="_username" placeholder="E-mail" aria-label="E-mail" required autocomplete="username" class="px-3 py-2 sm:py-1.5 bg-white/10 text-white border border-white/20 rounded-lg outline-none focus:ring-2 focus:ring-citrus/60 focus:bg-white/15 text-sm sm:text-xs sm:w-44 placeholder-white/60">
						<input type="password" name="_password" placeholder="{{ en ? 'Password' : 'Senha' }}" aria-label="{{ en ? 'Password' : 'Senha' }}" required autocomplete="current-password" class="px-3 py-2 sm:py-1.5 bg-white/10 text-white border border-white/20 rounded-lg outline-none focus:ring-2 focus:ring-citrus/60 focus:bg-white/15 text-sm sm:text-xs sm:w-36 placeholder-white/60">
						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
						<button type="submit" class="bg-citrus hover:bg-secondary-dark text-brand-900 transition-colors px-4 py-2 sm:py-1.5 rounded-lg font-bold">
							{{ en ? 'Sign in' : 'Entrar' }}
						</button>
					</form>
				</div>
			{% endif %}
		</div>

		<!-- Cabeçalho -->
		<header id="main-header" class="site-header sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-200/70 transition-shadow duration-300">
			<div class="header-row max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-4 h-20 lg:h-24 transition-all duration-300">
				<a href="{{ path('app_home', {_locale: app.request.locale}) }}" class="flex items-center gap-3 min-w-0 group" aria-label="CPA Citros — {{ tagline }}">
					<img src="{{ asset('images/logo.png') }}" alt="CPA Citros" width="595" height="595" class="brand-logo h-14 lg:h-[4.5rem] w-auto flex-shrink-0"/>
					<span class="brand-tagline block border-l border-slate-300 pl-3 text-[10.5px] sm:text-[11px] lg:text-xs leading-snug font-bold text-slate-700 max-w-[168px] sm:max-w-[210px] lg:max-w-[230px]">
						{{ tagline }}
					</span>
				</a>

				<nav class="hidden xl:flex items-center gap-0.5" aria-label="{{ en ? 'Main menu' : 'Menu principal' }}">
					{% for item in main_menu %}
						{% set active = current_section == item.route %}
						{% if loop.last %}
							<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="ml-3 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-full text-sm font-semibold transition-colors shadow-sm" {{ active ? 'aria-current="page"' }}>{{ en ? item.en : item.pt }}</a>
						{% elseif item.children is defined %}
							<div class="relative group/submenu">
								<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors {{ active ? 'text-primary bg-primary/10' : 'text-slate-600 hover:text-primary hover:bg-primary/5' }}" {{ active ? 'aria-current="page"' }}>
									{{ en ? item.en : item.pt }}
									<i class="fa-solid fa-chevron-down text-[9px] opacity-60 transition-transform group-hover/submenu:rotate-180" aria-hidden="true"></i>
								</a>
								<div class="absolute left-0 top-full pt-2 hidden group-hover/submenu:block group-focus-within/submenu:block">
									<ul class="min-w-[240px] rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 border-t-2 border-citrus p-2">
										{% for child in item.children %}
											<li>
												<a href="{{ path(item.route, {_locale: app.request.locale}) }}#{{ child.anchor }}" class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-primary/5 hover:text-primary">{{ en ? child.en : child.pt }}</a>
											</li>
										{% endfor %}
									</ul>
								</div>
							</div>
						{% else %}
							<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors {{ active ? 'text-primary bg-primary/10' : 'text-slate-600 hover:text-primary hover:bg-primary/5' }}" {{ active ? 'aria-current="page"' }}>{{ en ? item.en : item.pt }}</a>
						{% endif %}
					{% endfor %}
				</nav>

				<button id="mobile-menu-toggle" type="button" class="xl:hidden flex-shrink-0 w-11 h-11 inline-flex items-center justify-center rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" aria-label="{{ en ? 'Open menu' : 'Abrir menu' }}" aria-expanded="false" aria-controls="mobile-menu">
					<i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
				</button>
			</div>

			<div id="mobile-menu" class="hidden xl:hidden border-t border-slate-200 bg-white max-h-[calc(100svh-7rem)] overflow-y-auto">
				<nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4 grid gap-1" aria-label="{{ en ? 'Main menu' : 'Menu principal' }}">
					{% for item in main_menu %}
						{% set active = current_section == item.route %}
						{% if loop.last %}
							<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="mt-2 bg-primary text-white px-5 py-3.5 rounded-xl text-center font-semibold">{{ en ? item.en : item.pt }}</a>
						{% else %}
							<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="px-4 py-3.5 rounded-xl font-semibold flex items-center justify-between {{ active ? 'text-primary bg-primary/10' : 'text-slate-700 active:bg-slate-100' }}" {{ active ? 'aria-current="page"' }}>
								{{ en ? item.en : item.pt }}
								<i class="fa-solid fa-chevron-right text-xs opacity-40" aria-hidden="true"></i>
							</a>
							{% for child in item.children ?? [] %}
								<a href="{{ path(item.route, {_locale: app.request.locale}) }}#{{ child.anchor }}" class="ml-4 px-4 py-2.5 border-l-2 border-slate-200 text-sm font-medium text-slate-600 active:bg-slate-100">{{ en ? child.en : child.pt }}</a>
							{% endfor %}
						{% endif %}
					{% endfor %}
				</nav>
			</div>
		</header>

		{% for type, messages in app.flashes(['contact_s', 'contact_f', 'registration_s']) %}
			{% for message in messages %}
				{% set ok = type != 'contact_f' %}
				<div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4 w-full">
					<div class="{{ ok ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' }} border px-4 py-3 rounded-xl flex items-center gap-2" role="status">
						<i class="fa-solid {{ ok ? 'fa-circle-check text-emerald-600' : 'fa-circle-exclamation text-red-600' }}" aria-hidden="true"></i>
						<span>{{ message }}</span>
					</div>
				</div>
			{% endfor %}
		{% endfor %}

		<main id="conteudo" class="flex-1">
			{% block body %}{% endblock %}
		</main>

		<!-- Rodapé -->
		{% set footer_categories = get_footer_categories() %}
		{% set logo_heights = {lg: 'h-14', md: 'h-12', sm: 'h-10'} %}
		{% set logo_widths = {lg: 'max-w-[140px]', md: 'max-w-[120px]', sm: 'max-w-[100px]'} %}
		<footer class="mt-auto bg-white border-t border-slate-200">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-14">
				<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
					<div class="lg:col-span-4 flex items-center gap-4">
						<img src="{{ asset('images/logo.png') }}" alt="CPA Citros" width="595" height="595" class="h-20 w-auto flex-shrink-0" loading="lazy">
						<p class="text-sm leading-snug font-medium text-slate-600 border-l border-slate-300 pl-4 max-w-[240px]">{{ tagline }}</p>
					</div>

					{% if footer_categories is not empty %}
						<div class="lg:col-span-8 flex flex-wrap justify-between gap-x-12 gap-y-8">
							{% for group in footer_categories %}
								{% set height = logo_heights[group.category.logoSize] ?? 'h-12' %}
								{% set max_width = logo_widths[group.category.logoSize] ?? 'max-w-[120px]' %}
								<div class="min-w-0 w-full sm:w-auto sm:flex-none">
									<h2 class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500 pb-2 mb-4 border-b border-slate-300">{{ group.category.name(app.request.locale) }}</h2>
									<ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
										{% for company in group.companies %}
											{% set url = company.fullUrl %}
											<li>
												<{{ url ? 'a' : 'span' }} {% if url %}href="{{ url }}" {% if company.newTab %}target="_blank" rel="noopener noreferrer"{% endif %}{% endif %} class="inline-flex items-center justify-center rounded-lg transition-opacity {{ url ? 'hover:opacity-80' }}" title="{{ company.name }}">
													{% if company.logo and company.logo.imageName %}
														<img src="{{ asset('uploads/' ~ company.logo.imageName) }}" alt="{{ company.name }}" class="{{ height }} {{ max_width }} w-auto object-contain" loading="lazy">
													{% else %}
														<span class="{{ height }} inline-flex items-center px-3 rounded-lg border border-slate-200 text-slate-700 font-extrabold tracking-tight text-sm whitespace-nowrap">{{ company.name }}</span>
													{% endif %}
												</{{ url ? 'a' : 'span' }}>
											</li>
										{% endfor %}
									</ul>
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>

				<div class="mt-10 pt-6 border-t border-slate-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm">
					<nav aria-label="{{ en ? 'Footer menu' : 'Menu do rodapé' }}" class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-6 gap-y-2">
						{% for item in main_menu %}
							<a href="{{ path(item.route, {_locale: app.request.locale}) }}" class="text-slate-600 hover:text-primary font-medium">{{ en ? item.en : item.pt }}</a>
						{% endfor %}
					</nav>
					<a href="mailto:contato@cpacitros.com.br" class="inline-flex items-center gap-2 text-slate-700 hover:text-primary font-semibold">
						<i class="fa-solid fa-envelope text-primary" aria-hidden="true"></i>
						contato@cpacitros.com.br
					</a>
				</div>
			</div>

			<div class="bg-brand-900 text-white/80 text-xs">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-center">
					<span>&copy; {{ "now"|date("Y") }} CPA Citros — {{ en ? 'All rights reserved' : 'Todos os direitos reservados' }}</span>
					<span class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
						{% for page in get_public_pages() %}
							<a href="{{ path('app_pagina_detalhe', {slug: (en ? page.slugEn : page.slugPt), _locale: app.request.locale}) }}" class="hover:text-white">{{ en ? page.titleEn : page.titlePt }}</a>
						{% endfor %}
						<span class="text-white/50">{{ en ? 'Developed by' : 'Desenvolvido por' }} <a href="https://wab.com.br" target="_blank" rel="noopener noreferrer" class="font-semibold text-white/70 hover:text-white">WAB</a></span>
					</span>
				</div>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const header = document.getElementById('main-header');
				const onScroll = () => {
					const scrolled = window.scrollY > 24;
					header.classList.toggle('is-scrolled', scrolled);
					header.classList.toggle('shadow-md', scrolled);
				};
				window.addEventListener('scroll', onScroll, {passive: true});
				onScroll();

				const bindToggle = (buttonId, panelId) => {
					const button = document.getElementById(buttonId);
					const panel = document.getElementById(panelId);
					if (!button || !panel) return;
					button.addEventListener('click', () => {
						const open = panel.classList.toggle('hidden') === false;
						button.setAttribute('aria-expanded', open ? 'true' : 'false');
						button.querySelector('.fa-chevron-down')?.classList.toggle('rotate-180', open);
						const icon = button.querySelector('.fa-bars, .fa-xmark');
						if (icon) {
							icon.classList.toggle('fa-bars', !open);
							icon.classList.toggle('fa-xmark', open);
						}
						if (open) panel.querySelector('input')?.focus();
					});
				};
				bindToggle('mobile-menu-toggle', 'mobile-menu');
				bindToggle('researcher-toggle', 'researcher-login');

				const mobileMenu = document.getElementById('mobile-menu');
				mobileMenu?.querySelectorAll('a[href*="#"]').forEach((link) => link.addEventListener('click', () => {
					if (!mobileMenu.classList.contains('hidden')) document.getElementById('mobile-menu-toggle').click();
				}));
			});
		</script>

		{% block javascripts %}{% endblock %}
	</body>
</html>
