{% extends 'pub/base.html.twig' %}

{% block body %}
<!-- Hero Section (Banners com Slider / Destaque Dinâmico) -->
{% set active_banner = banners|first %}
{% if active_banner %}
<section class="relative bg-theme-gradient text-white border-0 py-32 lg:py-48 overflow-hidden isolate border-b border-white/10">
    <div class="absolute top-0 -left-40 w-96 h-96 bg-primary rounded-full mix-blend-screen filter blur-[128px] opacity-20 animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute bottom-0 -right-40 w-96 h-96 bg-secondary rounded-full mix-blend-screen filter blur-[128px] opacity-20"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="text-xs font-semibold tracking-widest uppercase text-slate-300">
                    {{ app.request.locale == 'en' ? 'New Agricultural Front' : 'Nova Frente no Agronegócio' }}
                </span>
            </div>
            <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-[1.1]">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400">
                    {{ app.request.locale == 'en' ? active_banner.titleEn : active_banner.titlePt }}
                </span>
            </h1>
            <p class="text-lg lg:text-xl text-slate-300 max-w-xl mb-10 leading-relaxed font-medium">
                {{ app.request.locale == 'en' ? active_banner.subtitleEn : active_banner.subtitlePt }}
            </p>
            <div class="flex flex-wrap gap-4">
                {% if active_banner.buttonLink %}
                    <a href="{{ active_banner.buttonLink }}" class="bg-primary hover:bg-primary-dark text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-primary/30 transition-all hover:-translate-y-0.5 ring-1 ring-inset ring-white/20">
                        {{ app.request.locale == 'en' ? (active_banner.buttonTextEn ?: 'Learn More') : (active_banner.buttonTextPt ?: 'Saiba Mais') }}
                    </a>
                {% endif %}
                <a href="{{ path('app_sobre', {_locale: app.request.locale}) }}" class="bg-white/30 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-xl backdrop-blur-md border border-white/10 transition-all">
                    {{ app.request.locale == 'en' ? 'Who We Are' : 'Quem Somos' }}
                </a>
            </div>
        </div>
        <div class="md:w-1/2 w-full mt-12 md:mt-0 relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-2xl ring-1 ring-white/10">
                {% if active_banner.image and active_banner.image.imageName %}
                    <img src="{{ asset('uploads/' ~ active_banner.image.imageName) }}" alt="CPA Citros" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                {% else %}
                    <img src="{{ asset('images/banner1.jpg') }}" alt="CPA Citros" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                {% endif %}
                <div class="absolute inset-0 border-4 border-white/10 rounded-3xl z-20 pointer-events-none"></div>
            </div>
        </div>
    </div>
</section>
{% endif %}

<!-- Bento Grid Moderno: Institucional / HLB -->
<section class="py-32 bg-white relative">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-20">
            <h2 class="text-primary font-bold tracking-widest uppercase text-sm mb-3">
                {{ app.request.locale == 'en' ? 'About CPA' : 'Conheça o CPA' }}
            </h2>
            <h3 class="text-4xl font-extrabold text-slate-900 tracking-tight">
                {{ app.request.locale == 'en' ? 'Network Infrastructure for a Global Challenge' : 'Infraestrutura em Rede para um Desafio Global' }}
            </h3>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            <!-- Bento Box 1: Sobre -->
            <div class="col-span-1 lg:col-span-2 bg-slate-50 rounded-3xl p-8 lg:p-12 border border-slate-200 shadow-sm relative overflow-hidden group hover:shadow-xl transition-all duration-500">
                <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors"></div>
                <div class="relative z-10 md:w-2/3">
                    <h4 class="text-2xl font-bold text-slate-900 mb-4">
                        {{ app.request.locale == 'en' ? 'Cutting-Edge Structure' : 'Estrutura de Ponta' }}
                    </h4>
                    <p class="text-slate-600 mb-8 leading-relaxed">
                        {{ app.request.locale == 'en' ? 'Our activities involve scientists from 17 research institutions in Brazil and global partners, connecting biology and management in real time.' : 'As atividades envolvem cientistas de 17 instituições de pesquisa no Brasil e de outros centros mundiais, conectando as descobertas botânicas, vetores e biologia molecular em tempo real.' }}
                    </p>
                    <a href="{{ path('app_sobre', {_locale: app.request.locale}) }}" class="inline-flex items-center font-semibold text-primary group-hover:text-primary-dark transition-colors">
                        {{ app.request.locale == 'en' ? 'Learn more about governance' : 'Saiba mais sobre a governança' }}
                        <span class="ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>
                </div>
                <img src="{{ asset('images/sobre.jpg') }}" class="mt-8 md:absolute md:right-8 md:bottom-8 md:w-1/3 rounded-2xl shadow-lg ring-1 ring-slate-900/5 group-hover:-translate-y-2 transition-transform duration-500" alt="Laboratório">
            </div>

            <!-- Bento Box 2: HLB -->
            <div class="col-span-1 bg-theme-gradient text-white border-0 rounded-3xl p-8 lg:p-12 border border-slate-800 shadow-2xl relative overflow-hidden group hover:-translate-y-1 transition-all duration-500">
                <img src="{{ asset('images/hlb.jpg') }}" class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-overlay group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-transparent"></div>
                <div class="relative z-10 flex flex-col h-full justify-end">
                    <div class="inline-flex px-3 py-1 rounded bg-secondary text-slate-900 font-bold text-xs uppercase mb-4 w-max">
                        {{ app.request.locale == 'en' ? 'Botanical Threat' : 'Ameaça Botânica' }}
                    </div>
                    <h4 class="text-2xl font-bold text-white mb-2">
                        {{ app.request.locale == 'en' ? 'The HLB Crisis' : 'A Crise do HLB' }}
                    </h4>
                    <p class="text-slate-300 text-sm mb-6 leading-relaxed">
                        {{ app.request.locale == 'en' ? 'Greening is caused by the Candidatus Liberibacter bacterium, spread by the psyllid insect vector.' : 'O Greening é causado pela bactéria Candidatus Liberibacter, propagada pelo inseto vetor psilídeo.' }}
                    </p>
                    <a href="{{ path('app_pesquisa', {_locale: app.request.locale}) }}" class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold backdrop-blur text-sm text-center transition-colors border border-white/5">
                        {{ app.request.locale == 'en' ? 'Research Details' : 'Detalhes da Pesquisa' }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Magazine Feed Notícias -->
<section class="py-32 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
            <div>
                <h2 class="text-primary font-bold tracking-widest uppercase text-sm mb-3">
                    {{ app.request.locale == 'en' ? 'News Feed' : 'Radar de Notícias' }}
                </h2>
                <h3 class="text-4xl font-extrabold text-slate-900 tracking-tight">
                    {{ app.request.locale == 'en' ? 'Latest Updates' : 'Últimas Atualizações' }}
                </h3>
            </div>
            <a href="{{ path('app_comunicacao', {_locale: app.request.locale}) }}" class="rounded-full px-6 py-3 bg-white border border-slate-200 text-slate-700 font-medium hover:bg-slate-100 transition-colors shadow-sm text-sm">
                {{ app.request.locale == 'en' ? 'View all news' : 'Ver quadro de mídias' }}
            </a>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {% for item in news %}
            {% set title = app.request.locale == 'en' ? item.titleEn : item.titlePt %}
            {% set summary = app.request.locale == 'en' ? item.summaryEn : item.summaryPt %}
            {% set slug = app.request.locale == 'en' ? item.slugEn : item.slugPt %}
            <article class="bg-white rounded-3xl p-4 border border-slate-100 shadow-sm hover:shadow-2xl hover:shadow-slate-200/50 transition-all duration-500 group flex flex-col hover:-translate-y-2">
                <div class="aspect-video rounded-2xl overflow-hidden mb-6 relative ring-1 ring-slate-900/5">
                    {% if item.image and item.image.imageName %}
                        <img src="{{ asset('uploads/' ~ item.image.imageName) }}" alt="{{ title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out">
                    {% else %}
                        <img src="{{ asset('images/news1.jpg') }}" alt="{{ title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out">
                    {% endif %}
                    <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-slate-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
                        {{ item.date|date('d M Y') }}
                    </div>
                </div>
                <div class="px-4 pb-4 flex-1 flex flex-col">
                    <h4 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-primary transition-colors leading-snug">
                        {{ title }}
                    </h4>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6 flex-1">{{ summary }}</p>
                    <a href="{{ path('app_noticia_detalhe', {slug: slug, _locale: app.request.locale}) }}" class="text-secondary font-bold text-sm">
                        {{ app.request.locale == 'en' ? 'Read more' : 'Leia mais' }} <span class="inline-block group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>
                </div>
            </article>
            {% else %}
                <div class="col-span-3 text-center text-slate-500 py-12">
                    {{ app.request.locale == 'en' ? 'No news found.' : 'Nenhuma notícia cadastrada.' }}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}