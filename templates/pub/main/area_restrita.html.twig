{% extends 'pub/base.html.twig' %}
{% block title %}{{ app.request.locale == 'en' ? 'Restricted Area' : 'Área Restrita' }} | CPA Citros{% endblock %}
{% block body %}
<section class="bg-theme-gradient text-white border-0 text-white pt-32 pb-48 relative overflow-hidden isolate border-b-8 border-secondary">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary rounded-full blur-[128px] opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-slate-300 uppercase">
                    {{ app.request.locale == 'en' ? 'Private Repository' : 'Repositório Privado' }}
                </span>
            </div>
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 tracking-tight">
                {{ app.request.locale == 'en' ? 'Researchers restricted area' : 'Área Restrita de Pesquisadores' }}
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl leading-relaxed font-light">
                {{ app.request.locale == 'en' ? 'Access to primary databases, research activity logs and shared scientific data.' : 'Acesso a bancos de dados primários, relatórios parciais e arquivos compartilhados de interesse científico.' }}
            </p>
        </div>
    </div>
</section>

<!-- Document Folders Layout -->
<section class="py-24 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 -mt-32">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for folderName, docs in folders %}
                <div class="bg-white rounded-[2rem] p-8 shadow-xl border border-slate-200/60 ring-1 ring-slate-900/5 hover:-translate-y-1 transition-all duration-500 group">
                    <h3 class="text-xl font-extrabold text-slate-900 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
                        <i class="fa-solid fa-folder text-amber-500 text-lg"></i>
                        {{ folderName }}
                    </h3>
                    <ul class="space-y-4">
                        {% for doc in docs %}
                            {% set docTitle = app.request.locale == 'en' ? doc.titleEn : doc.titlePt %}
                            <li class="p-3 bg-slate-50 rounded-xl hover:bg-slate-100 hover:ring-1 hover:ring-slate-200 transition-all flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center text-primary ring-1 ring-slate-900/5">
                                    <i class="fa-regular fa-file-pdf"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-slate-900 truncate" title="{{ docTitle }}">{{ docTitle }}</p>
                                    {% if doc.fileName %}
                                        <a href="{{ asset('uploads/documents/' ~ doc.fileName) }}" download class="text-xs text-primary hover:text-primary-dark font-bold inline-flex items-center gap-1 mt-1">
                                            <i class="fa-solid fa-download"></i> {{ app.request.locale == 'en' ? 'Download' : 'Baixar' }}
                                        </a>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <div class="col-span-3 text-center py-20 bg-white rounded-3xl border border-dashed border-slate-300 shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl ring-1 ring-slate-100">
                        <i class="fa-regular fa-folder-open text-slate-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">
                        {{ app.request.locale == 'en' ? 'No Documents Available' : 'Nenhum Arquivo Disponível' }}
                    </h3>
                    <p class="text-slate-500 max-w-sm mx-auto">
                        {{ app.request.locale == 'en' ? 'We do not have files uploaded for you in this workspace yet.' : 'Ainda não foram disponibilizados arquivos científicos em seu painel.' }}
                    </p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
