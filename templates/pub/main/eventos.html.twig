{% extends 'pub/base.html.twig' %}
{% block title %}{{ app.request.locale == 'en' ? 'Events' : 'Eventos' }} | CPA Citros{% endblock %}
{% block body %}
<section class="bg-theme-gradient text-white border-0 text-white pt-32 pb-48 relative overflow-hidden isolate border-b-8 border-secondary">
    <img src="{{ asset('images/workshop_biologico_banner.png') }}" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-overlay pointer-events-none z-0">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary rounded-full blur-[128px] opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-slate-300 uppercase">
                    {{ app.request.locale == 'en' ? 'Official Schedule' : 'Cronograma Oficial' }}
                </span>
            </div>
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 tracking-tight">
                {{ app.request.locale == 'en' ? 'Agenda & Events' : 'Agenda & Eventos' }}
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl leading-relaxed font-light">
                {{ app.request.locale == 'en' ? 'Check the dates of upcoming workshops, academic training and key panels led by our scientific network.' : 'Confira as datas dos próximos workshops, treinamentos acadêmicos e os fóruns principais protagonizados por nossa rede científica.' }}
            </p>
        </div>
    </div>
</section>

<!-- Agenda Grid de Alta Frequência -->
<section class="py-32 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <h2 class="text-3xl font-extrabold text-slate-900 mb-12 tracking-tight flex items-center gap-4">
            {{ app.request.locale == 'en' ? 'Featured' : 'Em destaque' }}
            <span class="w-12 h-px bg-slate-300"></span>
        </h2>
        
        <div class="grid lg:grid-cols-2 gap-10">
            {% for evento in agenda %}
                {% set title = app.request.locale == 'en' ? evento.titleEn : evento.titlePt %}
                {% set date = app.request.locale == 'en' ? evento.dateEn : evento.datePt %}
                {% set slug = app.request.locale == 'en' ? evento.slugEn : evento.slugPt %}
                <article class="relative flex flex-col md:flex-row bg-white rounded-3xl overflow-hidden shadow-xl shadow-slate-200/50 border border-slate-100 group hover:-translate-y-1 transition-all duration-500 hover:border-slate-300 hover:shadow-2xl">
                    <div class="md:w-2/5 aspect-square md:aspect-auto bg-slate-100 relative overflow-hidden">
                        {% if evento.image and evento.image.imageName %}
                            <img src="{{ asset('uploads/' ~ evento.image.imageName) }}" alt="Poster do Evento" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-in-out mix-blend-multiply opacity-90">
                        {% else %}
                            <img src="{{ asset('images/workshop_biologico_banner.png') }}" alt="Poster do Evento" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-in-out mix-blend-multiply opacity-90">
                        {% endif %}
                        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-slate-900/60 to-transparent mix-blend-multiply"></div>
                    </div>
                    <div class="p-8 md:w-3/5 flex flex-col justify-between">
                        <div>
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-secondary/10 text-secondary-dark font-bold text-xs uppercase tracking-widest ring-1 ring-inset ring-secondary/20 mb-4">
                                <i class="fa-solid fa-calendar-days"></i> {{ date }}
                            </div>
                            <h3 class="text-2xl font-bold text-slate-900 mb-4 leading-tight group-hover:text-primary transition-colors">{{ title }}</h3>
                        </div>
                        <div class="mt-8 pt-6 border-t border-slate-100">
                            <a href="{{ path('app_evento_detalhe', {slug: slug, _locale: app.request.locale}) }}" class="flex items-center justify-between w-full text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">
                                {{ app.request.locale == 'en' ? 'More Information' : 'Mais Informações' }}
                                <span class="bg-slate-100 p-2 rounded-full group-hover:bg-primary/50 transition-colors">&rarr;</span>
                            </a>
                        </div>
                    </div>
                </article>
            {% else %}
                <div class="col-span-2 text-center py-20 bg-white rounded-3xl border border-dashed border-slate-300 shadow-sm">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl ring-1 ring-slate-100">📅</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">
                        {{ app.request.locale == 'en' ? 'Agenda Clear' : 'Agenda Limpa' }}
                    </h3>
                    <p class="text-slate-500 max-w-sm mx-auto">
                        {{ app.request.locale == 'en' ? 'No events scheduled for this quarter. Stay tuned to the news feed.' : 'Nenhum evento agendado neste trimestre. Fique de olho na aba de comunicação.' }}
                    </p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Acervo Passados Library -->
<section class="py-32 bg-white relative overflow-hidden">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/3 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative z-10">
        <h2 class="text-sm font-bold tracking-widest text-slate-400 uppercase mb-4">
            {{ app.request.locale == 'en' ? 'Repository' : 'Repositório' }}
        </h2>
        <h3 class="text-4xl font-extrabold text-slate-900 mb-6 tracking-tight">
            {{ app.request.locale == 'en' ? 'Past Events Library' : 'Biblioteca de Eventos Anteriores' }}
        </h3>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-16">
            {{ app.request.locale == 'en' ? 'Knowledge does not stop. Review presentations, download PDFs presented on stage, or check report compilations.' : 'O conhecimento não para. Revise palestras, faça download dos PDFs apresentados no palco ou de relatórios fechados de eventos antigos.' }}
        </p>
        
        <div class="max-w-4xl mx-auto bg-slate-50 p-12 md:p-20 rounded-[2.5rem] border border-slate-200 flex flex-col items-center justify-center shadow-inner relative group isolate">
            <div class="w-20 h-20 bg-white rounded-2xl shadow-md rotate-3 mb-8 flex items-center justify-center text-4xl ring-1 ring-slate-900/5 group-hover:-rotate-3 transition-transform duration-500 text-slate-600">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>
            <h4 class="text-2xl font-bold text-slate-900 mb-4">
                {{ app.request.locale == 'en' ? 'Restricted Repository' : 'Acervo Restrito' }}
            </h4>
            <p class="text-slate-500 max-w-md">
                {{ app.request.locale == 'en' ? 'To access full proceedings and related heavy media files, log into the Researchers Area.' : 'Para acessar os Anais de Eventos e demais mídias pesadas, efetue login na Área Restrita dos Pesquisadores.' }}
            </p>
            <div class="mt-8 px-6 py-2 rounded-full border border-slate-300 text-slate-600 font-bold text-sm tracking-widest uppercase bg-white shadow-sm">
                {{ app.request.locale == 'en' ? 'In Processing' : 'Em Processamento' }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
