{% extends 'pub/base.html.twig' %}
{% set title = app.request.locale == 'en' ? item.titleEn : item.titlePt %}
{% set content = app.request.locale == 'en' ? item.contentEn : item.contentPt %}

{% block title %}{{ title }} | CPA Citros{% endblock %}
{% block meta_description %}{{ content|striptags|slice(0, 160) }}...{% endblock %}
{% block body %}
<div class="bg-slate-50 py-12 pb-24 sm:py-20 sm:pb-40 lg:py-24 lg:pb-48">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
        
        <div class="mb-10">
            <a href="{{ path('app_home', {_locale: app.request.locale}) }}" class="text-slate-400 hover:text-primary transition-colors inline-flex items-center gap-3">
                <i class="fa-solid fa-arrow-left text-lg"></i>
                <span class="text-sm font-bold text-slate-400 uppercase tracking-widest hover:text-primary transition-colors">
                    {{ app.request.locale == 'en' ? 'Institutional Page' : 'Página Institucional' }}
                </span>
            </a>
        </div>
        
        <div class="bg-white rounded-3xl lg:rounded-[2rem] shadow-xl ring-1 ring-slate-900/5 overflow-hidden">
            <!-- Header da Página -->
            <div class="bg-primary p-12 lg:p-16 relative overflow-hidden isolate text-white">
                <div class="absolute -right-20 -top-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none mix-blend-screen"></div>
                
                <div class="relative z-10">
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{{ title }}</h1>
                </div>
            </div>
            
            <!-- Conteúdo da Página -->
            <div class="p-12 lg:p-16 bg-white">
                <div class="prose prose-slate prose-lg max-w-none">
                    {{ content|raw }}
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}
