{% extends 'pub/base.html.twig' %}
{% set title = app.request.locale == 'en' ? item.titleEn : item.titlePt %}
{% set summary = app.request.locale == 'en' ? item.summaryEn : item.summaryPt %}
{% set content = app.request.locale == 'en' ? item.contentEn : item.contentPt %}
{% set status = app.request.locale == 'en' ? item.statusEn : item.statusPt %}
{% set estaAberta = item.statusPt|lower == 'aberto' or item.statusPt|lower == 'aberta' or item.statusEn|lower == 'open' %}

{% block title %}{{ title }} | CPA Citros{% endblock %}
{% block body %}
<div class="bg-slate-50 py-24 pb-48">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
        
        <div class="mb-8 inline-flex items-center gap-3">
            <a href="{{ path('app_oportunidades', {_locale: app.request.locale}) }}" class="text-slate-400 hover:text-primary transition-colors">
                <i class="fa-solid fa-arrow-left text-lg"></i>
            </a>
            <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">
                {{ app.request.locale == 'en' ? 'Vacancy Notice / Selection Process' : 'Edital / Processo Seletivo' }}
            </span>
        </div>
        
        <article class="bg-white rounded-[2rem] shadow-xl ring-1 ring-slate-900/5 overflow-hidden {% if not estaAberta %}opacity-90{% endif %}">
            <div class="p-10 md:p-16 border-b border-slate-100 relative overflow-hidden isolate">
                {% if estaAberta %}
                    <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -z-10"></div>
                {% endif %}
                
                <div class="flex items-center gap-3 mb-6">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase {% if estaAberta %}bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20{% else %}bg-slate-100 text-slate-500 ring-1 ring-inset ring-slate-400/20{% endif %}">
                        {% if estaAberta %}<span class="w-1.5 h-1.5 rounded-full bg-green-500 relative"><span class="absolute inset-0 bg-green-500 animate-ping rounded-full opacity-75"></span></span>{% endif %}
                        Status: {{ status }}
                    </span>
                </div>
                
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{{ title }}</h1>
                <p class="text-xl text-slate-500 leading-relaxed font-light">{{ summary }}</p>
            </div>
            
            <div class="p-10 md:p-16">
                <!-- Requisitos e Conteudo -->
                <div class="prose prose-slate prose-lg max-w-none {% if not estaAberta %}grayscale opacity-80{% endif %}">
                    {{ content|raw }}
                </div>
                
                <div class="mt-16 bg-theme-gradient text-white border-0 p-8 md:p-12 rounded-3xl text-center relative overflow-hidden shadow-inset">
                    {% if estaAberta %}
                        <h3 class="text-2xl font-bold text-white mb-3 relative z-10">
                            {{ app.request.locale == 'en' ? 'Applications Open' : 'Inscrições Abertas' }}
                        </h3>
                        <p class="text-slate-300 mb-8 max-w-md mx-auto relative z-10">
                            {{ app.request.locale == 'en' ? 'Required documents and curriculum details should be sent to the official desk.' : 'Os documentos comprobatórios devem ser enviados via e-mail para a secretaria do CPA.' }}
                        </p>
                        <a href="mailto:vagas@cpacitros.com.br?subject=Inscricao: {{ title }}" class="relative z-10 inline-block px-10 py-4 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl ring-1 ring-inset ring-primary-light shadow-[0_0_20px_rgba(0,154,61,0.4)] transition-all hover:scale-105">
                            {{ app.request.locale == 'en' ? 'Apply Now via E-mail' : 'Candidatar-se por E-mail' }}
                        </a>
                    {% else %}
                        <h3 class="text-2xl font-bold text-white mb-3">
                            {{ app.request.locale == 'en' ? 'Notice Closed' : 'Edital Encerrado' }}
                        </h3>
                        <p class="text-slate-300 mb-8 max-w-md mx-auto">
                            {{ app.request.locale == 'en' ? 'This position is currently closed or already filled.' : 'Vaga preenchida pela junta administrativa do Fapesp / CPA Citros.' }}
                        </p>
                        <button disabled class="px-10 py-4 bg-slate-800 text-slate-500 font-bold rounded-xl uppercase tracking-widest text-sm cursor-not-allowed border border-slate-700">
                            {{ app.request.locale == 'en' ? 'Inactive' : 'Inativo' }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </article>
        
    </div>
</div>
{% endblock %}
