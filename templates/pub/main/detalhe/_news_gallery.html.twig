{% set en = app.request.locale == 'en' %}
<figure class="news-gallery my-8 sm:my-10 -mx-5 sm:mx-0" aria-roledescription="carousel" aria-label="{{ en ? 'Photo gallery' : 'Galeria de fotos' }}">
    <div class="relative">
        <div class="gallery-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar sm:rounded-2xl bg-slate-900" tabindex="0">
            {% for photo in gallery %}
                {% set caption = photo.caption(app.request.locale) %}
                <div class="gallery-slide snap-center shrink-0 w-full" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ gallery|length }}">
                    <div class="aspect-[4/3] sm:aspect-video w-full flex items-center justify-center">
                        <img src="{{ asset('uploads/' ~ photo.image.imageName) }}" alt="{{ caption ?: title ~ ' — ' ~ (en ? 'photo' : 'foto') ~ ' ' ~ loop.index }}" class="w-full h-full object-contain" {{ loop.first ? '' : 'loading="lazy"' }}>
                    </div>
                    {% if caption %}
                        <p class="px-5 sm:px-0 pt-3 text-sm text-slate-500 bg-white">{{ caption }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% if gallery|length > 1 %}
            <button type="button" class="gallery-prev hidden sm:flex absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/90 hover:bg-white shadow items-center justify-center text-slate-800" aria-label="{{ en ? 'Previous photo' : 'Foto anterior' }}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="gallery-next hidden sm:flex absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/90 hover:bg-white shadow items-center justify-center text-slate-800" aria-label="{{ en ? 'Next photo' : 'Próxima foto' }}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            <span class="gallery-counter absolute top-3 right-3 sm:right-3 rounded-full bg-black/60 text-white text-xs font-semibold px-2.5 py-1">1 / {{ gallery|length }}</span>
        {% endif %}
    </div>
    {% if gallery|length > 1 %}
        <div class="gallery-thumbs mt-3 px-5 sm:px-0 flex gap-2 overflow-x-auto no-scrollbar">
            {% for photo in gallery %}
                <button type="button" class="gallery-thumb shrink-0 w-16 h-12 sm:w-20 sm:h-14 rounded-lg overflow-hidden ring-2 ring-transparent opacity-60 hover:opacity-100 transition" data-index="{{ loop.index0 }}" aria-label="{{ en ? 'Photo' : 'Foto' }} {{ loop.index }}">
                    <img src="{{ asset('uploads/' ~ photo.image.imageName) }}" alt="" class="w-full h-full object-cover" loading="lazy">
                </button>
            {% endfor %}
        </div>
    {% endif %}
</figure>
<script>
(() => {
    const galleries = document.querySelectorAll('.news-gallery:not([data-ready])');
    galleries.forEach((gallery) => {
        gallery.dataset.ready = '1';
        const track = gallery.querySelector('.gallery-track');
        const slides = [...gallery.querySelectorAll('.gallery-slide')];
        const thumbs = [...gallery.querySelectorAll('.gallery-thumb')];
        const counter = gallery.querySelector('.gallery-counter');
        let current = 0;
        const go = (index) => {
            index = Math.max(0, Math.min(slides.length - 1, index));
            track.scrollTo({left: slides[index].offsetLeft, behavior: 'smooth'});
        };
        const update = () => {
            const index = Math.round(track.scrollLeft / track.clientWidth);
            if (index === current && counter?.dataset.init) return;
            current = index;
            if (counter) { counter.textContent = `${index + 1} / ${slides.length}`; counter.dataset.init = '1'; }
            thumbs.forEach((thumb, i) => {
                thumb.classList.toggle('opacity-60', i !== index);
                thumb.classList.toggle('ring-citrus', i === index);
                thumb.classList.toggle('ring-transparent', i !== index);
                if (i === index) thumb.scrollIntoView({block: 'nearest', inline: 'nearest'});
            });
        };
        track.addEventListener('scroll', () => requestAnimationFrame(update), {passive: true});
        gallery.querySelector('.gallery-prev')?.addEventListener('click', () => go(current - 1));
        gallery.querySelector('.gallery-next')?.addEventListener('click', () => go(current + 1));
        thumbs.forEach((thumb) => thumb.addEventListener('click', () => go(Number(thumb.dataset.index))));
        track.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight') { event.preventDefault(); go(current + 1); }
            if (event.key === 'ArrowLeft') { event.preventDefault(); go(current - 1); }
        });
        update();
    });
})();
</script>
