{% extends 'pub/base.html.twig' %}
{% set nome = app.request.locale == 'en' ? item.nomeEn : item.nomePt %}
{% set objetivo = app.request.locale == 'en' ? item.objetivoEn : item.objetivoPt %}
{% set descricao = app.request.locale == 'en' ? item.descricaoEn : item.descricaoPt %}
{% set modulo = app.request.locale == 'en' ? item.moduloEn : item.moduloPt %}

{% block title %}{{ nome }} | CPA Citros{% endblock %}
{% block meta_description %}{{ objetivo }}{% endblock %}
{% block body %}
<!-- Detalhe do Pesquisa: Tech UI Layout -->
<div class="bg-slate-50 py-24 pb-48">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
        
        <div class="mb-10">
            <a href="{{ path('app_pesquisa', {_locale: app.request.locale}) }}" class="text-slate-400 hover:text-primary transition-colors inline-flex items-center gap-3">
                <i class="fa-solid fa-arrow-left text-lg"></i>
                <span class="text-sm font-bold text-slate-400 uppercase tracking-widest hover:text-primary transition-colors">
                    {{ app.request.locale == 'en' ? 'Scientific Project Details' : 'Detalhe do Projeto Científico' }}
                </span>
            </a>
        </div>
        
        <div class="bg-white rounded-[2rem] shadow-xl ring-1 ring-slate-900/5 overflow-hidden">
            <!-- Header do Projeto -->
            <div class="bg-primary p-12 lg:p-16 relative overflow-hidden isolate text-white">
                <div class="absolute -right-20 -top-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none mix-blend-screen"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row justify-between items-start gap-8">
                    <div>
                        <div class="inline-flex items-center px-3 py-1 rounded bg-secondary text-slate-900 font-bold text-xs uppercase mb-6">{{ modulo }}</div>
                        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{{ nome }}</h1>
                        <p class="text-slate-100 text-lg max-w-xl leading-relaxed">{{ objetivo }}</p>
                    </div>
                    
                    <!-- Avatar Responsável -->
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 ring-1 ring-white/20 text-center min-w-[200px] flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-secondary mx-auto flex items-center justify-center text-slate-900 font-bold text-xl mb-3 shadow-inner">
                            {{ item.pesquisador ? item.pesquisador.nome|slice(3, 1) : 'C' }}
                        </div>
                        <p class="text-xs text-slate-200 font-medium uppercase tracking-widest mb-1">
                            {{ app.request.locale == 'en' ? 'Coordinating' : 'Coordenação' }}
                        </p>
                        <p class="font-bold text-white">{{ item.pesquisador ? item.pesquisador.nome : 'CPA Citros' }}</p>
                    </div>
                </div>
            </div>
            
            <!-- Descrição e Métricas -->
            <div class="p-12 lg:p-16 bg-white">
                <h3 class="text-2xl font-bold text-slate-900 mb-6">
                    {{ app.request.locale == 'en' ? 'Executive Summary' : 'Resumo Executivo' }}
                </h3>
                <div class="prose prose-slate prose-lg max-w-none">
                    {{ descricao|raw }}
                </div>
                
                <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-slate-100 pt-10">
                    <div>
                        <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Status</p>
                        <p class="font-bold text-slate-900 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                            {{ app.request.locale == 'en' ? 'Active / In progress' : 'Ativo / Em andamento' }}
                        </p>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">
                            {{ app.request.locale == 'en' ? 'Funding' : 'Financiamento' }}
                        </p>
                        <p class="font-bold text-slate-900">
                            {{ app.request.locale == 'en' ? 'Joint Venture (Global)' : 'Misto / Parcerias' }}
                        </p>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}
