{% extends 'pub/base.html.twig' %}
{% set title = app.request.locale == 'en' ? item.titleEn : item.titlePt %}
{% set content = app.request.locale == 'en' ? item.contentEn : item.contentPt %}
{% set date = app.request.locale == 'en' ? item.dateEn : item.datePt %}

{% block title %}{{ title }} | CPA Citros{% endblock %}
{% block meta_description %}{{ content|striptags|slice(0, 160) }}...{% endblock %}
{% block body %}
<div class="bg-slate-50 py-12 pb-24 sm:py-20 sm:pb-40 lg:py-24 lg:pb-48">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
        
        <div class="mb-8">
            <a href="{{ path('app_eventos', {_locale: app.request.locale}) }}" class="text-slate-400 hover:text-primary transition-colors inline-flex items-center gap-3">
                <i class="fa-solid fa-arrow-left text-lg"></i>
                <span class="text-sm font-bold text-slate-400 uppercase tracking-widest hover:text-primary transition-colors">
                    {{ app.request.locale == 'en' ? 'Event Information' : 'Informações do Evento' }}
                </span>
            </a>
        </div>
        
        <article class="bg-white rounded-3xl lg:rounded-[2rem] shadow-xl ring-1 ring-slate-900/5 border border-slate-100 overflow-hidden">
            <div class="min-h-[240px] md:min-h-[380px] aspect-[21/9] w-full bg-theme-gradient text-white border-0 relative">
                {% if item.image and item.image.imageName %}
                    <img src="{{ asset('uploads/' ~ item.image.imageName) }}" alt="" class="w-full h-full object-cover mix-blend-luminosity opacity-40">
                {% else %}
                    <img src="{{ asset('images/workshop_biologico_banner.png') }}" alt="" class="w-full h-full object-cover mix-blend-luminosity opacity-40">
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/30 to-transparent flex items-end p-5 sm:p-8 md:p-12">
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-secondary text-slate-900 font-bold text-xs uppercase mb-3">
                            <i class="fa-solid fa-calendar-days"></i> {{ date }}
                        </div>
                        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">{{ title }}</h1>
                    </div>
                </div>
            </div>
            
            <div class="p-5 sm:p-10 md:p-16">
                <div class="rich-content prose prose-slate prose-base sm:prose-lg max-w-none mb-10 sm:mb-12">
                    {{ content|raw }}
                </div>
                
                {% if registrationForm %}
                    <section id="inscricao" class="scroll-mt-28 rounded-2xl bg-slate-50 ring-1 ring-slate-200 p-5 sm:p-8">
                        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">{{ app.request.locale == 'en' ? 'Registration' : 'Inscrição' }}</h2>
                        <p class="mt-1 text-sm text-slate-500">{{ app.request.locale == 'en' ? 'Fill in the form below. Fields marked with * are required.' : 'Preencha o formulário abaixo. Os campos com * são obrigatórios.' }}</p>
                        {{ form_start(registrationForm, {attr: {class: 'mt-6 grid gap-4 sm:grid-cols-2'}}) }}
                            {% for field in [registrationForm.name, registrationForm.institution, registrationForm.role, registrationForm.city, registrationForm.email, registrationForm.phone] %}
                                <div class="{{ field.vars.name == 'name' ? 'sm:col-span-2' }}">
                                    <label for="{{ field.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-1.5">{{ field.vars.label }} <span class="text-red-500">*</span></label>
                                    {{ form_widget(field, {attr: {class: 'w-full h-12 px-4 rounded-xl border bg-white text-base outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary ' ~ (field.vars.valid ? 'border-slate-300' : 'border-red-400')}}) }}
                                    {% for error in field.vars.errors %}
                                        <p class="mt-1 text-sm text-red-600">{{ error.message }}</p>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                            <div class="sm:col-span-2">
                                <label for="{{ registrationForm.file.file.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-1.5">{{ registrationForm.file.vars.label }}</label>
                                {{ form_widget(registrationForm.file.file, {attr: {class: 'block w-full text-sm text-slate-600 file:mr-4 file:h-11 file:px-4 file:rounded-xl file:border-0 file:bg-primary/10 file:text-primary-dark file:font-semibold hover:file:bg-primary/20 rounded-xl border border-dashed border-slate-300 bg-white p-2', accept: '.pdf,.doc,.docx,.jpg,.jpeg,.png'}}) }}
                                {% for error in registrationForm.file.vars.errors|merge(registrationForm.file.file.vars.errors) %}
                                    <p class="mt-1 text-sm text-red-600">{{ error.message }}</p>
                                {% endfor %}
                            </div>
                            {% for error in registrationForm.vars.errors %}
                                <p class="sm:col-span-2 text-sm text-red-600">{{ error.message }}</p>
                            {% endfor %}
                            <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
                                <p class="text-xs text-slate-500">{{ app.request.locale == 'en' ? 'Your data is used only for this event, in accordance with the LGPD.' : 'Seus dados são usados apenas para este evento, conforme a LGPD.' }}</p>
                                <button type="submit" class="w-full sm:w-auto h-12 px-8 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl transition-colors">
                                    {{ app.request.locale == 'en' ? 'Submit registration' : 'Enviar inscrição' }}
                                </button>
                            </div>
                        {{ form_rest(registrationForm) }}
                        {{ form_end(registrationForm) }}
                    </section>
                {% else %}
                <div class="bg-slate-50 rounded-2xl p-5 sm:p-8 border border-slate-100 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div>
                        <h4 class="font-bold text-slate-900 text-lg mb-1">
                            {{ app.request.locale == 'en' ? 'Registration / Tickets' : 'Inscrições / Participação' }}
                        </h4>
                        <p class="text-slate-500 text-sm">
                            {% if item.registrationLink is not empty %}
                                {{ app.request.locale == 'en' ? 'Click the button to access the external registration form.' : 'Clique no botão ao lado para acessar o formulário externo de inscrição.' }}
                            {% else %}
                                {{ app.request.locale == 'en' ? 'Contact our academic coordinate board or check university portals for open seat opportunities.' : 'Verifique com a rede de sua universidade afiliada a disponibilidade de assentos neste evento.' }}
                            {% endif %}
                        </p>
                    </div>
                    {% if item.registrationLink is not empty %}
                        <a href="{{ item.registrationLink }}" target="_blank" rel="noopener noreferrer" class="w-full md:w-auto text-center px-8 py-3 bg-primary text-white font-bold rounded-xl shadow-sm hover:bg-primary-dark transition-colors ring-1 ring-inset ring-primary">
                            {{ app.request.locale == 'en' ? 'Register Now' : 'Inscreva-se Já' }}
                        </a>
                    {% else %}
                        <a href="mailto:eventos@cpacitros.com.br?subject=Interesse: {{ title }}" class="w-full md:w-auto text-center px-8 py-3 bg-primary text-white font-bold rounded-xl shadow-sm hover:bg-primary-dark transition-colors ring-1 ring-inset ring-primary">
                            {{ app.request.locale == 'en' ? 'I Want to Participate' : 'Quero Participar' }}
                        </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </article>
        
    </div>
</div>
{% endblock %}
