{% extends 'pub/base.html.twig' %}
{% set area = app.request.locale == 'en' ? item.areaEn : item.areaPt %}

{% set curriculo = '' %}
{% if app.request.locale == 'en' %}
    {% if item.curriculoEn is not empty %}
        {% set curriculo = item.curriculoEn %}
    {% else %}
        {% set curriculo = item.curriculoPt %}
    {% endif %}
{% else %}
    {% if item.curriculoPt is not empty %}
        {% set curriculo = item.curriculoPt %}
    {% else %}
        {% set curriculo = item.curriculoEn %}
    {% endif %}
{% endif %}

{% block title %}{{ item.nome }} | CPA Citros{% endblock %}
{% block meta_description %}{{ item.nome }} - {{ area }}. {{ curriculo|striptags|slice(0, 150) }}...{% endblock %}
{% block body %}
<div class="bg-slate-50 py-12 pb-24 sm:py-20 sm:pb-40 lg:py-24 lg:pb-48">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
        
        <div class="mb-10">
            <a href="{{ path('app_pesquisa', {_locale: app.request.locale}) }}" class="text-slate-400 hover:text-primary transition-colors inline-flex items-center gap-3">
                <i class="fa-solid fa-arrow-left text-lg"></i>
                <span class="text-sm font-bold text-slate-400 uppercase tracking-widest hover:text-primary transition-colors">
                    {{ app.request.locale == 'en' ? 'Researcher Profile' : 'Perfil do Pesquisador' }}
                </span>
            </a>
        </div>
        
        <div class="bg-white rounded-3xl lg:rounded-[2rem] shadow-xl ring-1 ring-slate-900/5 overflow-hidden">
            <!-- Header do Pesquisador -->
            <div class="bg-primary p-12 lg:p-16 relative overflow-hidden isolate text-white">
                <div class="absolute -right-20 -top-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none mix-blend-screen"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8">
                    <!-- Foto -->
                    <div class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden bg-slate-100 ring-4 ring-white/20 flex-shrink-0">
                        {% if item.foto and item.foto.imageName %}
                            <img src="{{ asset('uploads/' ~ item.foto.imageName) }}" alt="{{ item.nome }}" class="w-full h-full object-cover">
                        {% else %}
                            <img src="{{ asset('images/foto_pesquisador.png') }}" alt="{{ item.nome }}" class="w-full h-full object-cover">
                        {% endif %}
                    </div>
                    
                    <!-- Info -->
                    <div class="text-center md:text-left flex-grow">
                        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-2">{{ item.nome }}</h1>
                        <p class="text-slate-200 text-lg mb-6">{{ area }}</p>
                        
                        <!-- Badges de Redes Sociais / Lattes / Email -->
                        <div class="flex flex-wrap justify-center md:justify-start gap-3">
                            {% if item.lattes %}
                                <a href="{{ item.lattes }}" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white transition-all text-xs font-bold uppercase tracking-wider ring-1 ring-white/10">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                    Currículo Lattes
                                </a>
                            {% endif %}
                            {% if item.linkedin %}
                                <a href="{{ item.linkedin }}" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white transition-all text-xs font-bold uppercase tracking-wider ring-1 ring-white/10">
                                    <i class="fa-brands fa-linkedin-in"></i>
                                    LinkedIn
                                </a>
                            {% endif %}
                            {% if item.email %}
                                <a href="mailto:{{ item.email }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white transition-all text-xs font-bold uppercase tracking-wider ring-1 ring-white/10">
                                    <i class="fa-solid fa-envelope"></i>
                                    E-mail
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Biografia / Currículo -->
            <div class="p-12 lg:p-16 bg-white">
                <h3 class="text-2xl font-bold text-slate-900 mb-6 border-b border-slate-100 pb-4">
                    {{ app.request.locale == 'en' ? 'Biography / Professional Curriculum' : 'Biografia / Currículo Profissional' }}
                </h3>
                <div class="prose prose-slate prose-lg max-w-none">
                    {{ curriculo|raw }}
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}
