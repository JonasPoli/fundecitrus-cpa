{% extends 'pub/base.html.twig' %}
{% block title %}{{ app.request.locale == 'en' ? 'Contact Us' : 'Fale Conosco' }} | CPA Citros{% endblock %}
{% block body %}
<section class="bg-theme-gradient text-white border-0 text-white pt-32 pb-48 relative overflow-hidden isolate border-b-8 border-secondary">
    <img src="{{ asset('images/banner2.jpg') }}" class="absolute inset-0 w-full h-full object-cover opacity-15 mix-blend-overlay pointer-events-none z-0">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary rounded-full blur-[128px] opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-slate-300 uppercase">
                    {{ app.request.locale == 'en' ? 'Support Desk' : 'Atendimento' }}
                </span>
            </div>
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 tracking-tight">
                {{ app.request.locale == 'en' ? 'Contact Us' : 'Fale Conosco' }}
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl leading-relaxed font-light">
                {{ app.request.locale == 'en' ? 'Our administrative team is always open. Get in touch for institutional questions, partnerships, media or suggestions.' : 'Nossa equipe administrativa está de portas abertas. Entre em contato para assuntos institucionais, parcerias, imprensa ou sugestões.' }}
            </p>
        </div>
    </div>
</section>

<!-- Form UI Modern Tailwind Plus -->
<section class="py-24 bg-slate-50 relative">
    <div class="absolute top-0 inset-x-0 h-96 bg-gradient-to-b from-slate-900 to-transparent opacity-5 pointer-events-none"></div>
    <div class="max-w-3xl mx-auto px-6 relative z-10 -mt-16">
        <div class="bg-white rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden backdrop-blur-xl">
            
            <div class="p-8 md:p-12">
                <div class="mb-10 p-6 bg-slate-50 rounded-2xl border border-slate-100 flex items-start gap-5">
                    <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-sm text-primary ring-1 ring-slate-900/5 flex-shrink-0">
                        <i class="fa-solid fa-envelope text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold tracking-widest text-slate-400 uppercase mb-1">
                            {{ app.request.locale == 'en' ? 'Official E-mail Inbox' : 'Caixa de Entrada Oficial' }}
                        </h3>
                        <a href="mailto:contato@cpacitros.com.br" class="text-lg font-extrabold text-slate-900 hover:text-primary transition-colors">contato@cpacitros.com.br</a>
                    </div>
                </div>

                <form action="{{ path('app_contact_post', {_locale: app.request.locale}) }}" method="POST" class="space-y-8">
                    
                    <div>
                        <label for="name" class="block text-sm font-bold leading-6 text-slate-900 mb-2">
                            {{ app.request.locale == 'en' ? 'Full Name' : 'Nome Completo' }} <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative mt-2 rounded-xl shadow-sm">
                            <input type="text" name="name" id="name" required class="block w-full rounded-xl border-0 py-3.5 pl-4 text-slate-900 ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 transition-shadow bg-white hover:bg-slate-50" placeholder="{{ app.request.locale == 'en' ? 'e.g. John Doe' : 'ex. João da Silva' }}">
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-8">
                        <div>
                            <label for="email" class="block text-sm font-bold leading-6 text-slate-900 mb-2">
                                {{ app.request.locale == 'en' ? 'E-mail Address' : 'Endereço de E-mail' }} <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative mt-2 rounded-xl shadow-sm">
                                <input type="email" name="email" id="email" required class="block w-full rounded-xl border-0 py-3.5 pl-4 text-slate-900 ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 transition-shadow bg-white hover:bg-slate-50" placeholder="seu@email.com">
                            </div>
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-bold leading-6 text-slate-900 mb-2">
                                {{ app.request.locale == 'en' ? 'Phone Number' : 'Telefone' }}
                            </label>
                            <div class="relative mt-2 rounded-xl shadow-sm">
                                <input type="tel" name="phone" id="phone" class="block w-full rounded-xl border-0 py-3.5 pl-4 text-slate-900 ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 transition-shadow bg-white hover:bg-slate-50" placeholder="(11) 99999-9999">
                            </div>
                        </div>
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-bold leading-6 text-slate-900 mb-2">
                            {{ app.request.locale == 'en' ? 'Message' : 'Mensagem' }} <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative mt-2 rounded-xl shadow-sm">
                            <textarea name="message" id="message" rows="5" required class="block w-full rounded-xl border-0 py-3.5 pl-4 text-slate-900 ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 transition-shadow bg-white hover:bg-slate-50" placeholder="{{ app.request.locale == 'en' ? 'Describe your query or suggestion here...' : 'Escreva detalhadamente sua demanda...' }}"></textarea>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                        <p class="text-xs text-slate-500 max-w-xs">
                            {{ app.request.locale == 'en' ? 'Your data is safe and processed strictly under LGPD guidelines.' : 'Seus dados estão seguros e são tratados estritamente conforme as diretrizes da LGPD.' }}
                        </p>
                        <button type="submit" class="bg-theme-gradient text-white border-0 hover:bg-primary text-white font-bold p-4 lg:px-10 lg:py-4 rounded-xl shadow-lg ring-1 ring-slate-900/5 transition-all outline-none">
                            {{ app.request.locale == 'en' ? 'Send Message' : 'Enviar Mensagem' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
