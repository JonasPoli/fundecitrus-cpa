{% extends 'pub/base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Research' : 'Pesquisa' }} | CPA Citros{% endblock %}
{% block meta_description %}{{ app.request.locale == 'en' ? 'Active research projects and scientific documents published by CPA Citros.' : 'Projetos ativos de pesquisa e documentos científicos publicados pelo CPA Citros.' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <style>
        .dataTables_wrapper .dataTables_filter {
            display: none;
        }
        .dataTables_wrapper {
            width: 100% !important;
            overflow-x: auto;
        }
        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
            margin: 0 !important;
        }
        table.dataTable thead th {
            border-bottom: 1px solid #e2e8f0 !important;
            background-color: #f8fafc !important;
        }
        table.dataTable tbody td {
            border-bottom: 1px solid #e2e8f0 !important;
        }
        table.dataTable.no-footer {
            border-bottom: none !important;
        }
    </style>
{% endblock %}

{% block body %}
<section class="bg-theme-gradient text-white border-0 py-16 sm:py-24 lg:py-28 relative overflow-hidden isolate">
    <img src="{{ asset('images/hlb.jpg') }}" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-overlay pointer-events-none z-0">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary rounded-full blur-[128px] opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold mb-6 tracking-tight">
                {{ app.request.locale == 'en' ? 'Frontal Combat Against HLB' : 'Combate Frontal ao HLB' }}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed font-light">
                {{ app.request.locale == 'en' ? 'Greening destabilized continents. Our research fields operate by dissecting the problem into molecular, biological and defensive tactics.' : 'O Greening desestabilizou continentes. Nossas linhas de pesquisa atuam fatiando o problema em táticas moleculares, biológicas e defensivas.' }}
            </p>
            
        </div>
    </div>
</section>

{% set en = app.request.locale == 'en' %}
{% set slot_pools = [
    [{x: 175, y: 255}, {x: 330, y: 125}, {x: 310, y: 355}, {x: 150, y: 420}],
    [{x: 540, y: 150}, {x: 615, y: 330}, {x: 690, y: 190}, {x: 470, y: 300}],
] %}
{% set fruits = [] %}
{% set used = [0, 0] %}
{% for area in areas %}
    {% set pool_index = loop.index0 % 2 %}
    {% for line in area.lines %}
        {% set pool = slot_pools[pool_index] %}
        {% set slot = pool[used[pool_index]] ?? null %}
        {% if slot is null %}
            {% set pool_index = 1 - pool_index %}
            {% set slot = slot_pools[pool_index][used[pool_index]] ?? {x: 400, y: 80} %}
        {% endif %}
        {% set used = pool_index == 0 ? [used[0] + 1, used[1]] : [used[0], used[1] + 1] %}
        {% set fruits = fruits|merge([{line: line, area: area, areaIndex: loop.parent.loop.index0, slot: slot}]) %}
    {% endfor %}
{% endfor %}

<!-- Linhas de pesquisa: laranjeira -->
<section id="linhas" class="py-16 sm:py-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                {{ en ? 'Research lines' : 'Linhas de pesquisa' }}
            </h2>
            <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
                {{ en ? 'Each orange is a research line. Tap an orange to see its modules.' : 'Cada laranja é uma linha de pesquisa. Clique numa laranja para ver os módulos.' }}
            </p>
        </div>

        {% if fruits is empty %}
            <p class="mt-10 text-slate-500">{{ en ? 'Research lines will be published soon.' : 'As linhas de pesquisa serão publicadas em breve.' }}</p>
        {% else %}
        <div class="mt-8 lg:mt-12 grid gap-8 lg:gap-12 lg:grid-cols-[3fr_2fr] lg:items-start">
            <div class="relative">
                <svg id="research-tree" viewBox="0 0 800 640" class="w-full h-auto max-w-[520px] mx-auto lg:max-w-none" role="group" aria-label="{{ en ? 'Orange tree with research lines' : 'Laranjeira com as linhas de pesquisa' }}">
                    <defs>
                        <radialGradient id="fruit-a" cx="35%" cy="30%" r="75%">
                            <stop offset="0%" stop-color="#FFC75A"/>
                            <stop offset="55%" stop-color="#F59E2B"/>
                            <stop offset="100%" stop-color="#DB6A16"/>
                        </radialGradient>
                        <radialGradient id="fruit-b" cx="35%" cy="30%" r="75%">
                            <stop offset="0%" stop-color="#FFE08A"/>
                            <stop offset="55%" stop-color="#F6B93B"/>
                            <stop offset="100%" stop-color="#E5901A"/>
                        </radialGradient>
                        <linearGradient id="trunk" x1="0" x2="1">
                            <stop offset="0%" stop-color="#6B4428"/>
                            <stop offset="100%" stop-color="#8A5A36"/>
                        </linearGradient>
                        <filter id="fruit-shadow" x="-30%" y="-30%" width="160%" height="160%">
                            <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#0E3B2E" flood-opacity=".28"/>
                        </filter>
                    </defs>

                    <ellipse cx="400" cy="622" rx="190" ry="14" fill="#0E3B2E" opacity=".08"/>
                    <path d="M372 626 C378 560 384 520 386 470 C360 440 320 410 262 380 L272 364 C326 386 366 408 392 430 C394 380 398 330 396 280 L412 280 C414 330 414 380 414 428 C444 402 492 378 548 352 L556 368 C502 396 452 428 420 466 C420 520 424 566 434 626 Z" fill="url(#trunk)"/>

                    <g fill="#2E7D4F">
                        <circle cx="400" cy="230" r="190"/>
                        <circle cx="215" cy="290" r="150"/>
                        <circle cx="590" cy="280" r="150"/>
                        <circle cx="300" cy="140" r="120"/>
                        <circle cx="520" cy="130" r="125"/>
                        <circle cx="400" cy="360" r="120"/>
                    </g>
                    <g fill="#3F8F4A" opacity=".9">
                        <circle cx="250" cy="200" r="95"/>
                        <circle cx="560" cy="210" r="100"/>
                        <circle cx="410" cy="120" r="95"/>
                        <circle cx="160" cy="360" r="70"/>
                        <circle cx="650" cy="360" r="70"/>
                    </g>
                    <g fill="#5FA95B" opacity=".55">
                        <circle cx="330" cy="90" r="55"/>
                        <circle cx="480" cy="80" r="50"/>
                        <circle cx="200" cy="180" r="50"/>
                        <circle cx="620" cy="170" r="55"/>
                        <circle cx="420" cy="260" r="70"/>
                    </g>
                    <g fill="#8CC56B" opacity=".5">
                        <path d="M110 300 q30 -40 70 -20 q-30 40 -70 20z"/>
                        <path d="M690 260 q30 -40 70 -10 q-35 35 -70 10z"/>
                        <path d="M380 40 q30 -30 60 -5 q-30 30 -60 5z"/>
                        <path d="M240 420 q25 -30 60 -10 q-28 30 -60 10z"/>
                        <path d="M520 430 q30 -25 60 0 q-30 28 -60 0z"/>
                    </g>

                    {% for fruit in fruits %}
                        {% set label = fruit.line.name(app.request.locale) %}
                        <g class="tree-fruit cursor-pointer outline-none" data-line="{{ fruit.line.id }}" tabindex="0" role="button" aria-controls="line-{{ fruit.line.id }}" aria-label="{{ loop.index }}. {{ label }}">
                            <g class="fruit-body transition-transform duration-300" style="transform-origin: {{ fruit.slot.x }}px {{ fruit.slot.y }}px; transform-box: view-box;">
                                <circle cx="{{ fruit.slot.x }}" cy="{{ fruit.slot.y }}" r="80" fill="url(#fruit-{{ fruit.areaIndex % 2 == 0 ? 'a' : 'b' }})" filter="url(#fruit-shadow)"/>
                                <circle class="fruit-ring" cx="{{ fruit.slot.x }}" cy="{{ fruit.slot.y }}" r="86" fill="none" stroke="#fff" stroke-width="0" />
                                <path d="M{{ fruit.slot.x - 2 }} {{ fruit.slot.y - 78 }} q18 -26 44 -18 q-16 24 -44 18z" fill="#3F8F4A"/>
                                <circle cx="{{ fruit.slot.x - 28 }}" cy="{{ fruit.slot.y - 32 }}" r="12" fill="#fff" opacity=".35"/>
                                <text class="fruit-number sm:hidden" x="{{ fruit.slot.x }}" y="{{ fruit.slot.y }}" text-anchor="middle" dy="0.35em" font-size="64" font-weight="800" fill="#fff" font-family="Inter, sans-serif">{{ loop.index }}</text>
                                <foreignObject class="hidden sm:block" x="{{ fruit.slot.x - 66 }}" y="{{ fruit.slot.y - 60 }}" width="132" height="120">
                                    <div xmlns="http://www.w3.org/1999/xhtml" style="width:132px;height:120px;display:flex;align-items:center;justify-content:center;text-align:center;font-family:Inter,sans-serif;font-weight:800;font-size:15.5px;line-height:1.12;color:#fff;text-shadow:0 1px 2px rgba(120,50,0,.45);">{{ label }}</div>
                                </foreignObject>
                            </g>
                        </g>
                    {% endfor %}
                </svg>

                <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
                    {% for area in areas %}
                        <span class="inline-flex items-center gap-2">
                            <span class="w-3.5 h-3.5 rounded-full flex-shrink-0 {{ loop.index0 % 2 == 0 ? 'bg-[#F59E2B]' : 'bg-[#F6C343]' }}"></span>
                            {{ area.name(app.request.locale) }}
                        </span>
                    {% endfor %}
                </div>
            </div>

            <div id="research-lines" class="space-y-8">
                {% set number = 0 %}
                {% for area in areas %}
                    <div>
                        <h3 class="text-lg sm:text-xl font-extrabold text-brand-900 leading-snug tracking-tight mb-3 pb-2 border-b-2 {{ loop.index0 % 2 == 0 ? 'border-[#F59E2B]' : 'border-[#F6C343]' }} flex items-start gap-2.5">
                            <span class="mt-1.5 w-3.5 h-3.5 flex-shrink-0 rounded-full {{ loop.index0 % 2 == 0 ? 'bg-[#F59E2B]' : 'bg-[#F6C343]' }}"></span>
                            {{ area.name(app.request.locale) }}
                        </h3>
                        <div class="space-y-2">
                            {% for line in area.lines %}
                                {% set number = number + 1 %}
                                {% set description = line.description(app.request.locale) %}
                                <div id="line-{{ line.id }}" class="line-item rounded-2xl ring-1 ring-slate-200 bg-white transition-shadow scroll-mt-28" data-line="{{ line.id }}">
                                    <button type="button" class="line-toggle w-full flex items-center gap-3 text-left p-4" aria-expanded="false" aria-controls="line-panel-{{ line.id }}">
                                        <span class="w-9 h-9 flex-shrink-0 rounded-full {{ loop.parent.loop.index0 % 2 == 0 ? 'bg-[#F59E2B]' : 'bg-[#F6C343]' }} text-white font-extrabold flex items-center justify-center shadow-inner">{{ number }}</span>
                                        <span class="flex-1 font-bold text-slate-900 leading-snug">{{ line.name(app.request.locale) }}</span>
                                        {% if line.modules is not empty %}<span class="text-xs text-slate-500 whitespace-nowrap hidden sm:inline">{{ line.modules|length }} {{ line.modules|length == 1 ? (en ? 'module' : 'módulo') : (en ? 'modules' : 'módulos') }}</span>{% endif %}
                                        <i class="line-chevron fa-solid fa-chevron-down text-slate-400 text-sm transition-transform" aria-hidden="true"></i>
                                    </button>
                                    <div id="line-panel-{{ line.id }}" class="line-panel hidden px-4 pb-4">
                                        {% if description %}
                                            <p class="text-sm text-slate-600 leading-relaxed mb-3">{{ description }}</p>
                                        {% endif %}
                                        {% if line.modules is not empty %}
                                            <p class="text-xs font-semibold text-slate-500 mb-2">{{ en ? 'Modules' : 'Módulos' }}</p>
                                            <ul class="flex flex-wrap gap-2">
                                                {% for module in line.modules %}
                                                    <li class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 text-primary-dark px-3 py-1.5 text-sm font-medium">
                                                        <i class="fa-solid fa-leaf text-[10px]" aria-hidden="true"></i>{{ module.name(app.request.locale) }}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                        {% if line.projects is not empty %}
                                            <p class="text-xs font-semibold text-slate-500 mt-4 mb-2">{{ en ? 'Projects' : 'Projetos' }}</p>
                                            <ul class="space-y-1">
                                                {% for project in line.projects %}
                                                    <li>
                                                        <a href="{{ path('app_projeto_detalhe', {slug: en ? project.slugEn : project.slugPt, _locale: app.request.locale}) }}" class="text-sm text-primary hover:underline font-medium">{{ en ? project.nomeEn : project.nomePt }}</a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</section>

<!-- Projetos Table Layout Premium -->
<section class="py-16 sm:py-24 lg:py-32 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="sm:flex sm:items-center sm:justify-between mb-12">
            <div>
                <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                    {{ app.request.locale == 'en' ? 'Active Research Projects' : 'Projetos Ativos em Execução' }}
                </h2>
                <p class="mt-2 text-slate-600">
                    {{ app.request.locale == 'en' ? 'Catalogue of scientific research subfields led by coordinators.' : 'Catálogo das sublinhas de pesquisa lideradas pelos docentes.' }}
                </p>
            </div>
            
            <!-- Barra de Busca -->
            <div class="mt-4 sm:mt-0">
                <div class="flex gap-2">
                    <input type="text" id="projects-search-input" placeholder="{{ app.request.locale == 'en' ? 'Search projects...' : 'Buscar projetos...' }}" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm w-64 bg-white">
                </div>
            </div>
        </div>
        
        <div class="-mx-4 mt-8 overflow-x-auto rounded-2xl shadow ring-1 ring-slate-900/5 sm:-mx-6 md:mx-0 bg-white p-4">
            <table class="min-w-full divide-y divide-slate-300" id="projects-table" style="width: 100% !important;">
                <thead class="bg-slate-50">
                    <tr>
                        <!-- Mobile Header -->
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500 sm:pl-6 md:hidden">
                            {{ app.request.locale == 'en' ? 'Scientific Project Details' : 'Dados do Projeto Científico' }}
                        </th>
                        
                        <!-- Desktop Headers -->
                        <th scope="col" class="hidden md:table-cell py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500 sm:pl-6">
                            {{ app.request.locale == 'en' ? 'Module / Pillar' : 'Módulo / Pilar' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Project Name and Goal' : 'Nome do Projeto e Objetivo' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Coordinating' : 'Coordenação' }}
                        </th>
                        
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6 w-24">
                            <span class="sr-only">Ações</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for projeto in projetos %}
                    {% set nome = app.request.locale == 'en' ? projeto.nomeEn : projeto.nomePt %}
                    {% set objetivo = app.request.locale == 'en' ? projeto.objetivoEn : projeto.objetivoPt %}
                    {% set modulo = projeto.moduleLabel(app.request.locale) %}
                    {% set slug = app.request.locale == 'en' ? projeto.slugEn : projeto.slugPt %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <!-- Mobile Cell -->
                        <td class="py-5 pl-4 pr-3 text-sm sm:pl-6 md:hidden">
                            <div class="mb-2">
                                <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">{{ modulo }}</span>
                            </div>
                            <div class="font-bold text-slate-900 text-base leading-snug">{{ nome }}</div>
                            <div class="text-slate-500 mt-1 max-w-3xl leading-relaxed">{{ objetivo }}</div>
                            <div class="flex items-center gap-2 mt-3 text-slate-500 text-xs">
                                <span class="font-semibold text-slate-600">{{ app.request.locale == 'en' ? 'Coordinating:' : 'Coordenação:' }}</span>
                                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-primary/20 text-primary-dark">
                                    <span class="text-[10px] font-bold leading-none">{{ projeto.pesquisador ? projeto.pesquisador.nome|slice(0, 1) : 'C' }}</span>
                                </span>
                                <span class="font-semibold text-slate-700">{{ projeto.pesquisador ? projeto.pesquisador.nome : 'CPA' }}</span>
                            </div>
                        </td>
                        
                        <!-- Desktop Cells -->
                        <td class="hidden md:table-cell whitespace-nowrap py-5 pl-4 pr-3 text-sm sm:pl-6">
                            <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">{{ modulo }}</span>
                        </td>
                        <td class="hidden md:table-cell px-3 py-5 text-sm">
                            <div class="font-bold text-slate-900 text-base leading-snug">{{ nome }}</div>
                            <div class="text-slate-500 mt-1 max-w-sm">{{ objetivo }}</div>
                        </td>
                        <td class="hidden md:table-cell whitespace-nowrap px-3 py-5 text-sm">
                            <div class="flex items-center gap-3">
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary">
                                    <span class="text-xs font-medium leading-none text-white">{{ projeto.pesquisador ? projeto.pesquisador.nome|slice(0, 1) : 'C' }}</span>
                                </span>
                                <span class="font-semibold text-slate-700">{{ projeto.pesquisador ? projeto.pesquisador.nome : 'CPA' }}</span>
                            </div>
                        </td>
                        
                        <td class="relative whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-6 align-middle">
                            <a href="{{ path('app_projeto_detalhe', {slug: slug, _locale: app.request.locale}) }}" class="text-primary hover:text-primary-dark font-semibold">
                                {{ app.request.locale == 'en' ? 'Details' : 'Detalhes' }}
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Documentos de Projetos Section -->
<section class="py-16 sm:py-24 lg:py-32 bg-slate-100/50 relative border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div>
            <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                {{ app.request.locale == 'en' ? 'Project Documents' : 'Documentos de Projetos' }}
            </h2>
            <p class="mt-2 text-slate-600">
                {{ app.request.locale == 'en' ? 'Access scientific articles, abstracts and dissertations published by the research center.' : 'Acesse artigos científicos, abstracts e dissertações publicados pelo centro de pesquisa.' }}
            </p>
        </div>

        <!-- Filtros de Documentos -->
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-4 mb-6 mt-8">
            <input type="text" id="documents-search-input" placeholder="{{ app.request.locale == 'en' ? 'Search documents...' : 'Buscar documentos...' }}" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
            
            <select id="filter-type" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Types' : 'Todos os Tipos' }}</option>
                <option value="artigo">Artigo</option>
                <option value="abstract">Abstract</option>
                <option value="dissertação">{{ app.request.locale == 'en' ? 'Dissertation' : 'Dissertação' }}</option>
            </select>
            
            <select id="filter-year" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Years' : 'Todos os Anos' }}</option>
                {% set years = [] %}
                {% for doc in projectDocuments %}
                    {% if doc.year not in years and doc.year is not empty %}
                        {% set years = years|merge([doc.year]) %}
                    {% endif %}
                {% endfor %}
                {% for y in years|sort|reverse %}
                    <option value="{{ y }}">{{ y }}</option>
                {% endfor %}
            </select>

            <select id="filter-researcher" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Researchers' : 'Todos os Pesquisadores' }}</option>
                {% set researchers = [] %}
                {% for doc in projectDocuments %}
                    {% if doc.researcher not in researchers and doc.researcher is not empty %}
                        {% set researchers = researchers|merge([doc.researcher]) %}
                    {% endif %}
                {% endfor %}
                {% for r in researchers|sort %}
                    <option value="{{ r }}">{{ r }}</option>
                {% endfor %}
            </select>

            <button type="button" id="btn-clear-docs-filters" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-xl transition-colors flex items-center justify-center gap-2">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                {{ app.request.locale == 'en' ? 'Clear' : 'Limpar Filtros' }}
            </button>
        </div>

        <div class="-mx-4 mt-8 overflow-x-auto rounded-2xl shadow ring-1 ring-slate-900/5 sm:-mx-6 md:mx-0 bg-white p-4">
            <table id="documents-table" class="min-w-full divide-y divide-slate-300" style="width: 100% !important;">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500 sm:pl-6">
                            {{ app.request.locale == 'en' ? 'Document' : 'Documento' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Project' : 'Projeto' }}
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Type' : 'Tipo' }}
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Year' : 'Ano' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Researcher' : 'Pesquisador' }}
                        </th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6">
                            <span class="sr-only">Download</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for item in projectDocuments %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-5 pl-4 pr-3 text-sm sm:pl-6 font-bold text-slate-900">
                            {{ item.title }}
                        </td>
                        <td class="hidden md:table-cell px-3 py-5 text-sm text-slate-500">
                            {{ app.request.locale == 'en' ? item.project.nomeEn : item.project.nomePt }}
                        </td>
                        <td class="px-3 py-5 text-sm text-slate-500 font-medium">
                            <span class="type-val" style="display:none">{{ item.type }}</span>
                            {% if item.type == 'artigo' %}
                                <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Artigo</span>
                            {% elseif item.type == 'abstract' %}
                                <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Abstract</span>
                            {% else %}
                                <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-700/10">Dissertação</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-5 text-sm text-slate-500 year-val font-mono">
                            {{ item.year }}
                        </td>
                        <td class="hidden md:table-cell px-3 py-5 text-sm text-slate-500 researcher-val">
                            {{ item.researcher }}
                        </td>
                        <td class="relative whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                            {% if item.fileName %}
                                <a href="{{ asset('uploads/documents/' ~ item.fileName) }}" target="_blank" class="text-primary hover:text-primary-dark font-semibold">
                                    {{ app.request.locale == 'en' ? 'Download PDF' : 'Baixar PDF' }}
                                </a>
                            {% elseif item.doi %}
                                <a href="{{ item.doi }}" target="_blank" class="text-secondary hover:text-secondary-dark font-semibold">
                                    {{ app.request.locale == 'en' ? 'Access DOI' : 'Acessar DOI' }}
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Pesquisadores -->
{% set institutions = pesquisadores|map(p => p.institution)|filter(i => i is not empty)|reduce((carry, i) => i in carry ? carry : carry|merge([i]), [])|sort %}
<section id="pesquisadores" class="py-16 sm:py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div class="max-w-2xl">
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    {{ app.request.locale == 'en' ? 'Researchers' : 'Pesquisadores' }}
                </h2>
                <p class="mt-3 text-slate-600">
                    {{ app.request.locale == 'en' ? pesquisadores|length ~ ' researchers from institutions in Brazil and abroad.' : pesquisadores|length ~ ' pesquisadores de instituições do Brasil e do exterior.' }}
                </p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full lg:w-auto">
                <label class="relative block">
                    <span class="sr-only">{{ app.request.locale == 'en' ? 'Search by name' : 'Buscar por nome' }}</span>
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm" aria-hidden="true"></i>
                    <input type="search" id="researcher-search" placeholder="{{ app.request.locale == 'en' ? 'Search by name' : 'Buscar por nome' }}" class="w-full lg:w-64 h-11 pl-10 pr-3 rounded-xl border border-slate-300 bg-white text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                </label>
                <label class="block">
                    <span class="sr-only">{{ app.request.locale == 'en' ? 'Institution' : 'Instituição' }}</span>
                    <select id="researcher-institution" class="w-full lg:w-64 h-11 px-3 rounded-xl border border-slate-300 bg-white text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                        <option value="">{{ app.request.locale == 'en' ? 'All institutions' : 'Todas as instituições' }}</option>
                        {% for institution in institutions %}
                            <option value="{{ institution }}">{{ institution }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        </div>

        <ul role="list" id="researcher-list" class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {% for pessoa in pesquisadores %}
                {% set area = app.request.locale == 'en' ? pessoa.areaEn : pessoa.areaPt %}
                <li class="researcher-card min-w-0" data-name="{{ pessoa.nome|lower }}" data-institution="{{ pessoa.institution }}">
                    <div class="h-full flex items-center gap-3 rounded-2xl ring-1 ring-slate-200 bg-white p-3 pr-4 {{ pessoa.hasCurriculum ? 'hover:ring-primary/40 hover:shadow-md transition-all relative' }}">
                        {% if pessoa.foto and pessoa.foto.imageName %}
                            <img src="{{ asset('uploads/' ~ pessoa.foto.imageName) }}" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0" loading="lazy">
                        {% else %}
                            <span class="w-12 h-12 rounded-full bg-primary/10 text-primary-dark font-bold flex items-center justify-center flex-shrink-0" aria-hidden="true">{{ pessoa.initials }}</span>
                        {% endif %}
                        <div class="min-w-0 flex-1">
                            {% if pessoa.hasCurriculum %}
                                <a href="{{ path('app_pesquisador_detalhe', {id: pessoa.id, _locale: app.request.locale}) }}" class="font-semibold text-slate-900 leading-snug hover:text-primary after:absolute after:inset-0">{{ pessoa.nome }}</a>
                            {% else %}
                                <p class="font-semibold text-slate-900 leading-snug">{{ pessoa.nome }}</p>
                            {% endif %}
                            {% if pessoa.institution %}
                                <p class="text-sm text-slate-500 truncate">{{ pessoa.institution }}</p>
                            {% endif %}
                            {% if area %}
                                <p class="text-xs text-slate-400 truncate">{{ area }}</p>
                            {% endif %}
                        </div>
                        {% if pessoa.lattes %}
                            <a href="{{ pessoa.lattes }}" target="_blank" rel="noopener noreferrer" class="relative z-10 text-[11px] font-bold text-slate-400 hover:text-primary uppercase" title="Currículo Lattes">Lattes</a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
        <p id="researcher-empty" class="hidden mt-8 text-center text-slate-500">{{ app.request.locale == 'en' ? 'No researcher found.' : 'Nenhum pesquisador encontrado.' }}</p>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const items = [...document.querySelectorAll('.line-item')];
        const fruits = [...document.querySelectorAll('.tree-fruit')];

        const open = (id, scroll) => {
            items.forEach((item) => {
                const active = item.dataset.line === String(id);
                item.querySelector('.line-panel').classList.toggle('hidden', !active);
                item.querySelector('.line-toggle').setAttribute('aria-expanded', active ? 'true' : 'false');
                item.querySelector('.line-chevron').classList.toggle('rotate-180', active);
                item.classList.toggle('ring-2', active);
                item.classList.toggle('ring-citrus', active);
                item.classList.toggle('shadow-lg', active);
                if (active && scroll) {
                    const rect = item.getBoundingClientRect();
                    if (rect.top < 90 || rect.bottom > window.innerHeight) item.scrollIntoView({behavior: 'smooth', block: 'center'});
                }
            });
            fruits.forEach((fruit) => {
                const active = fruit.dataset.line === String(id);
                fruit.querySelector('.fruit-body').style.transform = active ? 'scale(1.08)' : '';
                fruit.querySelector('.fruit-ring').setAttribute('stroke-width', active ? '7' : '0');
                fruit.setAttribute('aria-expanded', active ? 'true' : 'false');
            });
        };

        items.forEach((item) => item.querySelector('.line-toggle').addEventListener('click', () => {
            const isOpen = item.querySelector('.line-toggle').getAttribute('aria-expanded') === 'true';
            open(isOpen ? null : item.dataset.line, false);
        }));
        fruits.forEach((fruit) => {
            fruit.addEventListener('click', () => open(fruit.dataset.line, true));
            fruit.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(fruit.dataset.line, true); }
            });
        });
        if (items.length) open(items[0].dataset.line, false);

        const search = document.getElementById('researcher-search');
        const institution = document.getElementById('researcher-institution');
        const cards = [...document.querySelectorAll('.researcher-card')];
        const empty = document.getElementById('researcher-empty');
        const normalize = (text) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const applyFilter = () => {
            const term = normalize(search.value.trim());
            const inst = institution.value;
            let visible = 0;
            cards.forEach((card) => {
                const show = (!term || normalize(card.dataset.name).includes(term)) && (!inst || card.dataset.institution === inst);
                card.classList.toggle('hidden', !show);
                if (show) visible++;
            });
            empty.classList.toggle('hidden', visible > 0);
        };
        search?.addEventListener('input', applyFilter);
        institution?.addEventListener('change', applyFilter);
    });
    </script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            const projTable = $('#projects-table').DataTable({
                paging: false,
                info: false,
                searching: true,
                dom: 't',
                language: {
                    zeroRecords: "{{ app.request.locale == 'en' ? 'No projects found.' : 'Nenhum projeto científico encontrado.' }}"
                }
            });
            
            $('#projects-search-input').on('keyup input', function() {
                projTable.search(this.value).draw();
            });

            const urlParams = new URLSearchParams(window.location.search);
            const initialSearch = urlParams.get('search');
            if (initialSearch) {
                $('#projects-search-input').val(initialSearch);
                projTable.search(initialSearch).draw();
            }

            const docTable = $('#documents-table').DataTable({
                paging: false,
                info: false,
                searching: true,
                dom: 't',
                language: {
                    zeroRecords: "{{ app.request.locale == 'en' ? 'No documents found.' : 'Nenhum documento científico encontrado.' }}"
                }
            });

            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    if (settings.nTable.id !== 'documents-table') {
                        return true;
                    }
                    
                    const selectedType = $('#filter-type').val();
                    const selectedYear = $('#filter-year').val();
                    const selectedResearcher = $('#filter-researcher').val();
                    
                    const rowType = $(docTable.row(dataIndex).node()).find('.type-val').text().trim();
                    const rowYear = $(docTable.row(dataIndex).node()).find('.year-val').text().trim();
                    const rowResearcher = $(docTable.row(dataIndex).node()).find('.researcher-val').text().trim();
                    
                    if (selectedType && rowType !== selectedType) {
                        return false;
                    }
                    if (selectedYear && rowYear !== selectedYear) {
                        return false;
                    }
                    if (selectedResearcher && rowResearcher !== selectedResearcher) {
                        return false;
                    }
                    
                    return true;
                }
            );

            $('#filter-type, #filter-year, #filter-researcher').on('change', function() {
                docTable.draw();
            });

            $('#documents-search-input').on('keyup input', function() {
                docTable.search(this.value).draw();
            });

            $('#btn-clear-docs-filters').on('click', function() {
                $('#documents-search-input').val('');
                $('#filter-type').val('');
                $('#filter-year').val('');
                $('#filter-researcher').val('');
                docTable.search('').draw();
            });
        });
    </script>
{% endblock %}
