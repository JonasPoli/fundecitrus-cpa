{% extends 'pub/base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Research' : 'Pesquisa' }} | CPA Citros{% endblock %}
{% block meta_description %}{{ app.request.locale == 'en' ? 'Research lines, projects and scientific documents of CPA Citros.' : 'Linhas de pesquisa, projetos e documentos científicos do CPA Citros.' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <style>
        .dataTables_wrapper .dataTables_filter {
            display: none;
        }
        .dataTables_wrapper {
            width: 100% !important;
            overflow-x: auto;
        }
        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
            margin: 0 !important;
        }
        table.dataTable thead th {
            border-bottom: 1px solid #e2e8f0 !important;
            background-color: #f8fafc !important;
        }
        table.dataTable tbody td {
            border-bottom: 1px solid #e2e8f0 !important;
        }
        table.dataTable.no-footer {
            border-bottom: none !important;
        }
    </style>
{% endblock %}

{% macro project_list(projects, en, locale) %}
    {% if projects is empty %}
        <p class="mt-5 text-sm text-slate-500">{{ en ? 'Projects will be published soon.' : 'Os projetos serão publicados em breve.' }}</p>
    {% else %}
        <div class="mt-5 grid gap-4 md:grid-cols-2">
            {% for project in projects %}
                {% set objective = en ? project.objetivoEn : project.objetivoPt %}
                <article class="flex gap-4 rounded-2xl bg-white ring-1 ring-slate-200 p-5">
                    <span class="w-9 h-9 flex-shrink-0 rounded-full bg-brand-800 text-white text-xs font-bold flex items-center justify-center">{{ '%02d'|format(loop.index) }}</span>
                    <div class="min-w-0">
                        <h5 class="text-lg font-bold text-slate-900 leading-snug">
                            <a href="{{ path('app_projeto_detalhe', {slug: en ? project.slugEn : project.slugPt, _locale: locale}) }}" class="hover:text-primary">{{ en ? project.nomeEn : project.nomePt }}</a>
                        </h5>
                        {% if project.pesquisador %}
                            <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500">{{ en ? 'Lead researcher' : 'Pesquisador responsável' }}</p>
                            <a href="{{ path('app_sobre', {_locale: locale}) }}#equipe-{{ project.pesquisador.id }}" class="text-sm font-bold text-primary hover:underline">{{ project.pesquisador.nome }}</a>
                        {% endif %}
                        {% if objective %}
                            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{{ objective }}</p>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% block body %}
{% import _self as macros %}
{% set en = app.request.locale == 'en' %}
<section class="bg-theme-gradient text-white border-0 py-16 sm:py-24 lg:py-28 relative overflow-hidden isolate">
    <img src="{{ asset('images/hlb.jpg') }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-overlay pointer-events-none z-0">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary rounded-full blur-[128px] opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-6 tracking-tight text-balance">
                {{ en ? 'Research and development for innovation and sustainability in citriculture' : 'Pesquisa e desenvolvimento para inovação e sustentabilidade da citricultura' }}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-3xl leading-relaxed font-light">
                {{ en ? 'CPA Citros carries out multidisciplinary research focused primarily on controlling HLB and mitigating the damage associated with the disease. Building on this scientific foundation, the center organizes the research lines and projects that guide its actions.' : 'O CPA Citros desenvolve pesquisas multidisciplinares voltadas prioritariamente ao controle do HLB e à mitigação dos danos associados à doença. A partir dessa base científica, são organizadas as linhas de pesquisa e projetos que direcionam as ações do centro.' }}
            </p>
        </div>
    </div>
</section>

<!-- Linhas de pesquisa > tópicos (módulos) > projetos -->
{% set fallback_images = ['images/hlb.jpg', 'images/sobre.jpg', 'images/banner2.jpg', 'images/news2.jpg'] %}
<section id="linhas" class="scroll-mt-20 py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                {{ en ? 'Research lines' : 'Linhas de pesquisa' }}
            </h2>
            <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
                {{ en ? 'Select a research line to see its topics and projects.' : 'Selecione uma linha de pesquisa para ver seus tópicos e projetos.' }}
            </p>
        </div>

        {% if lines is empty %}
            <p class="mt-10 text-slate-500">{{ en ? 'Research lines will be published soon.' : 'As linhas de pesquisa serão publicadas em breve.' }}</p>
        {% else %}
            <div class="mt-8 grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-4">
                {% for line in lines %}
                    {% set image = line.image and line.image.imageName ? asset('uploads/' ~ line.image.imageName) : asset(fallback_images[loop.index0 % fallback_images|length]) %}
                    {% set topics = line.modules|length %}
                    <button type="button" class="line-card group relative overflow-hidden rounded-3xl aspect-[4/5] lg:aspect-square text-left text-white shadow-sm ring-4 ring-transparent transition focus:outline-none focus-visible:ring-citrus/60" data-line="{{ line.id }}" aria-expanded="false" aria-controls="line-panel-{{ line.id }}">
                        <img src="{{ image }}" alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                        <span class="absolute inset-0 bg-gradient-to-t from-[#0E3B2E]/95 via-[#0E3B2E]/45 to-[#0E3B2E]/10"></span>
                        <span class="relative z-10 flex h-full flex-col justify-between p-4 sm:p-5">
                            <span class="flex items-center justify-between gap-2 text-xs font-semibold text-white/80">
                                <span>{{ '%02d'|format(loop.index) }}</span>
                                {% if topics %}
                                    <span>{{ topics }} {{ topics == 1 ? (en ? 'topic' : 'tópico') : (en ? 'topics' : 'tópicos') }}</span>
                                {% endif %}
                            </span>
                            <span class="flex items-end justify-between gap-2 sm:gap-3">
                                <span class="text-[15px] sm:text-xl lg:text-2xl font-bold leading-snug sm:leading-tight">{{ line.name(app.request.locale) }}</span>
                                <span class="w-7 h-7 sm:w-9 sm:h-9 flex-shrink-0 rounded-full bg-white/15 ring-1 ring-white/40 flex items-center justify-center">
                                    <i class="line-arrow fa-solid fa-arrow-right text-xs sm:text-sm transition-transform" aria-hidden="true"></i>
                                </span>
                            </span>
                        </span>
                    </button>
                {% endfor %}
            </div>

            {% for line in lines %}
                {% set loose_projects = projects.line[line.id] ?? [] %}
                {% set description = line.description(app.request.locale) %}
                <div id="line-panel-{{ line.id }}" class="line-panel hidden mt-6 scroll-mt-28 rounded-3xl bg-slate-50 ring-1 ring-slate-200 p-5 sm:p-8" data-line-panel="{{ line.id }}">
                    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 pb-5 border-b border-slate-200">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">{{ en ? 'Research line' : 'Linha de pesquisa' }}</p>
                            <h3 class="mt-1 text-2xl sm:text-3xl font-bold text-brand-900 leading-tight">{{ line.name(app.request.locale) }}</h3>
                        </div>
                        {% if line.modules is not empty %}
                            <p class="text-sm text-slate-500">{{ en ? 'Select a topic to see its projects' : 'Selecione um tópico para ver seus projetos' }}</p>
                        {% endif %}
                    </div>
                    {% if description %}
                        <p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">{{ description }}</p>
                    {% endif %}

                    {% if line.modules is not empty %}
                        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                            {% for module in line.modules %}
                                <button type="button" class="module-card w-full flex items-center gap-3 rounded-2xl bg-white ring-1 ring-slate-200 px-4 py-4 text-left transition hover:ring-primary/40" data-module="{{ module.id }}" aria-expanded="false" aria-controls="module-panel-{{ module.id }}">
                                    <span class="text-xs font-semibold text-slate-400">{{ '%02d'|format(loop.index) }}</span>
                                    <span class="flex-1 font-semibold text-slate-800 leading-snug">{{ module.name(app.request.locale) }}</span>
                                    <i class="module-chevron fa-solid fa-chevron-right text-xs text-slate-400 transition-transform" aria-hidden="true"></i>
                                </button>
                            {% endfor %}
                        </div>

                        {% for module in line.modules %}
                            <div id="module-panel-{{ module.id }}" class="module-panel hidden mt-6 scroll-mt-28 rounded-2xl bg-white ring-1 ring-slate-200 p-5 sm:p-6" data-module-panel="{{ module.id }}">
                                <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-100">
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">{{ en ? 'Related projects' : 'Projetos relacionados' }}</p>
                                        <h4 class="mt-1 text-xl sm:text-2xl font-bold text-brand-900 leading-tight">{{ module.name(app.request.locale) }}</h4>
                                    </div>
                                    <button type="button" class="module-close flex-shrink-0 inline-flex items-center gap-1.5 rounded-full ring-1 ring-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                                        {{ en ? 'Collapse' : 'Recolher' }}
                                        <i class="fa-solid fa-chevron-up text-[10px]" aria-hidden="true"></i>
                                    </button>
                                </div>
                                {{ macros.project_list(projects.module[module.id] ?? [], en, app.request.locale) }}
                            </div>
                        {% endfor %}

                        {% if loose_projects is not empty %}
                            <div class="mt-8">
                                <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">{{ en ? 'Other projects in this line' : 'Outros projetos da linha' }}</p>
                                {{ macros.project_list(loose_projects, en, app.request.locale) }}
                            </div>
                        {% endif %}
                    {% else %}
                        {{ macros.project_list(loose_projects, en, app.request.locale) }}
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
    </div>
</section>

<!-- Documentos de Projetos Section -->
<section id="documentos" class="scroll-mt-20 py-16 sm:py-24 lg:py-32 bg-slate-100/50 relative border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div>
            <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                {{ app.request.locale == 'en' ? 'Project Documents' : 'Documentos de Projetos' }}
            </h2>
            <p class="mt-2 text-slate-600">
                {{ app.request.locale == 'en' ? 'Access scientific articles, abstracts and dissertations published by the research center.' : 'Acesse artigos científicos, abstracts e dissertações publicados pelo centro de pesquisa.' }}
            </p>
        </div>

        <!-- Filtros de Documentos -->
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-4 mb-6 mt-8">
            <input type="text" id="documents-search-input" placeholder="{{ app.request.locale == 'en' ? 'Search documents...' : 'Buscar documentos...' }}" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
            
            <select id="filter-type" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Types' : 'Todos os Tipos' }}</option>
                <option value="artigo">Artigo</option>
                <option value="abstract">Abstract</option>
                <option value="dissertação">{{ app.request.locale == 'en' ? 'Dissertation' : 'Dissertação' }}</option>
            </select>
            
            <select id="filter-year" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Years' : 'Todos os Anos' }}</option>
                {% set years = [] %}
                {% for doc in projectDocuments %}
                    {% if doc.year not in years and doc.year is not empty %}
                        {% set years = years|merge([doc.year]) %}
                    {% endif %}
                {% endfor %}
                {% for y in years|sort|reverse %}
                    <option value="{{ y }}">{{ y }}</option>
                {% endfor %}
            </select>

            <select id="filter-researcher" class="px-4 py-2 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm bg-white">
                <option value="">{{ app.request.locale == 'en' ? 'All Researchers' : 'Todos os Pesquisadores' }}</option>
                {% set researchers = [] %}
                {% for doc in projectDocuments %}
                    {% if doc.researcher not in researchers and doc.researcher is not empty %}
                        {% set researchers = researchers|merge([doc.researcher]) %}
                    {% endif %}
                {% endfor %}
                {% for r in researchers|sort %}
                    <option value="{{ r }}">{{ r }}</option>
                {% endfor %}
            </select>

            <button type="button" id="btn-clear-docs-filters" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-xl transition-colors flex items-center justify-center gap-2">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                {{ app.request.locale == 'en' ? 'Clear' : 'Limpar Filtros' }}
            </button>
        </div>

        <div class="-mx-4 mt-8 overflow-x-auto rounded-2xl shadow ring-1 ring-slate-900/5 sm:-mx-6 md:mx-0 bg-white p-4">
            <table id="documents-table" class="min-w-full divide-y divide-slate-300" style="width: 100% !important;">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500 sm:pl-6">
                            {{ app.request.locale == 'en' ? 'Document' : 'Documento' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Project' : 'Projeto' }}
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Type' : 'Tipo' }}
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Year' : 'Ano' }}
                        </th>
                        <th scope="col" class="hidden md:table-cell px-3 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                            {{ app.request.locale == 'en' ? 'Researcher' : 'Pesquisador' }}
                        </th>
                        <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6">
                            <span class="sr-only">Download</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for item in projectDocuments %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-5 pl-4 pr-3 text-sm sm:pl-6 font-bold text-slate-900">
                            {{ item.title }}
                        </td>
                        <td class="hidden md:table-cell px-3 py-5 text-sm text-slate-500">
                            {{ app.request.locale == 'en' ? item.project.nomeEn : item.project.nomePt }}
                        </td>
                        <td class="px-3 py-5 text-sm text-slate-500 font-medium">
                            <span class="type-val" style="display:none">{{ item.type }}</span>
                            {% if item.type == 'artigo' %}
                                <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Artigo</span>
                            {% elseif item.type == 'abstract' %}
                                <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Abstract</span>
                            {% else %}
                                <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-700/10">Dissertação</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-5 text-sm text-slate-500 year-val font-mono">
                            {{ item.year }}
                        </td>
                        <td class="hidden md:table-cell px-3 py-5 text-sm text-slate-500 researcher-val">
                            {{ item.researcher }}
                        </td>
                        <td class="relative whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                            {% if item.fileName %}
                                <a href="{{ asset('uploads/documents/' ~ item.fileName) }}" target="_blank" class="text-primary hover:text-primary-dark font-semibold">
                                    {{ app.request.locale == 'en' ? 'Download PDF' : 'Baixar PDF' }}
                                </a>
                            {% elseif item.doi %}
                                <a href="{{ item.doi }}" target="_blank" class="text-secondary hover:text-secondary-dark font-semibold">
                                    {{ app.request.locale == 'en' ? 'Access DOI' : 'Acessar DOI' }}
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const lineCards = [...document.querySelectorAll('.line-card')];
        const linePanels = [...document.querySelectorAll('.line-panel')];

        const selectLine = (id) => {
            lineCards.forEach((card) => {
                const active = card.dataset.line === id;
                card.setAttribute('aria-expanded', active ? 'true' : 'false');
                card.classList.toggle('ring-citrus', active);
                card.classList.toggle('ring-transparent', !active);
                card.querySelector('.line-arrow').classList.toggle('rotate-90', active);
            });
            linePanels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.linePanel !== id));
            if (id) document.getElementById('line-panel-' + id).scrollIntoView({behavior: 'smooth', block: 'nearest'});
        };

        const selectModule = (linePanel, id) => {
            linePanel.querySelectorAll('.module-card').forEach((card) => {
                const active = card.dataset.module === id;
                card.setAttribute('aria-expanded', active ? 'true' : 'false');
                card.classList.toggle('ring-2', active);
                card.classList.toggle('ring-primary', active);
                card.classList.toggle('ring-1', !active);
                card.classList.toggle('ring-slate-200', !active);
                card.querySelector('.module-chevron').classList.toggle('rotate-90', active);
            });
            linePanel.querySelectorAll('.module-panel').forEach((panel) => panel.classList.toggle('hidden', panel.dataset.modulePanel !== id));
            if (id) document.getElementById('module-panel-' + id).scrollIntoView({behavior: 'smooth', block: 'nearest'});
        };

        lineCards.forEach((card) => card.addEventListener('click', () => {
            selectLine(card.getAttribute('aria-expanded') === 'true' ? null : card.dataset.line);
        }));
        document.querySelectorAll('.module-card').forEach((card) => card.addEventListener('click', () => {
            selectModule(card.closest('.line-panel'), card.getAttribute('aria-expanded') === 'true' ? null : card.dataset.module);
        }));
        document.querySelectorAll('.module-close').forEach((button) => button.addEventListener('click', () => {
            const linePanel = button.closest('.line-panel');
            selectModule(linePanel, null);
            linePanel.scrollIntoView({behavior: 'smooth', block: 'nearest'});
        }));
    });
    </script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            const docTable = $('#documents-table').DataTable({
                paging: false,
                info: false,
                searching: true,
                dom: 't',
                language: {
                    zeroRecords: "{{ app.request.locale == 'en' ? 'No documents found.' : 'Nenhum documento científico encontrado.' }}"
                }
            });

            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    if (settings.nTable.id !== 'documents-table') {
                        return true;
                    }
                    
                    const selectedType = $('#filter-type').val();
                    const selectedYear = $('#filter-year').val();
                    const selectedResearcher = $('#filter-researcher').val();
                    
                    const rowType = $(docTable.row(dataIndex).node()).find('.type-val').text().trim();
                    const rowYear = $(docTable.row(dataIndex).node()).find('.year-val').text().trim();
                    const rowResearcher = $(docTable.row(dataIndex).node()).find('.researcher-val').text().trim();
                    
                    if (selectedType && rowType !== selectedType) {
                        return false;
                    }
                    if (selectedYear && rowYear !== selectedYear) {
                        return false;
                    }
                    if (selectedResearcher && rowResearcher !== selectedResearcher) {
                        return false;
                    }
                    
                    return true;
                }
            );

            $('#filter-type, #filter-year, #filter-researcher').on('change', function() {
                docTable.draw();
            });

            $('#documents-search-input').on('keyup input', function() {
                docTable.search(this.value).draw();
            });

            $('#btn-clear-docs-filters').on('click', function() {
                $('#documents-search-input').val('');
                $('#filter-type').val('');
                $('#filter-year').val('');
                $('#filter-researcher').val('');
                docTable.search('').draw();
            });
        });
    </script>
{% endblock %}
